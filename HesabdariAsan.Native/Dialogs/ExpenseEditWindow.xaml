<Window x:Class="HesabdariAsan.Native.Dialogs.ExpenseEditWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="هزینه" Width="600" Height="545" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft" Background="{DynamicResource AppBackground}">
 <Border Style="{StaticResource DialogCard}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Padding="22,20,22,17" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="مالی" Style="{StaticResource Eyebrow}"/><TextBlock x:Name="TitleText" Text="ثبت هزینه" Style="{StaticResource DialogTitle}"/><TextBlock Text="هزینه در سود خالص و گزارش‌ها محاسبه می‌شود." Style="{StaticResource SmallMuted}"/></StackPanel><Border Grid.Column="1" Width="48" Height="48" CornerRadius="14" Background="{DynamicResource DangerSoft}"><Viewbox Width="23" Height="23"><Path Data="{StaticResource IconExpense}" Stroke="{DynamicResource Danger}" StrokeThickness="1.7" Fill="Transparent"/></Viewbox></Border></Grid></Border>
  <StackPanel Grid.Row="1" Margin="22,18,22,10">
   <TextBlock Text="عنوان هزینه" Style="{StaticResource FieldLabel}"/><TextBox x:Name="NameBox" Style="{StaticResource Input}" Margin="0,0,0,14"/>
   <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,7,0"><TextBlock Text="دسته" Style="{StaticResource FieldLabel}"/><TextBox x:Name="CategoryBox" Style="{StaticResource Input}"/></StackPanel><StackPanel Grid.Column="1" Margin="7,0,0,0"><TextBlock Text="مبلغ" Style="{StaticResource FieldLabel}"/><TextBox x:Name="AmountBox" Style="{StaticResource Input}" FlowDirection="LeftToRight" TextAlignment="Left"/></StackPanel></Grid>
   <TextBlock Text="یادداشت" Style="{StaticResource FieldLabel}"/><TextBox x:Name="NoteBox" Style="{StaticResource Input}" Height="92" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="11,9"/>
  </StackPanel>
  <Border Grid.Row="2" Padding="22,15" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"><StackPanel Orientation="Horizontal" HorizontalAlignment="Left"><Button Content="انصراف" Width="96" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="Cancel_Click"/><Button Content="ذخیره هزینه" Width="118" Style="{StaticResource PrimaryButton}" Click="Save_Click"/></StackPanel></Border>
 </Grid></Border>
</Window>