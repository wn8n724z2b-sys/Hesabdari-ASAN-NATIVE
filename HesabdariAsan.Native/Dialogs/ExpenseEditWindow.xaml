<Window x:Class="HesabdariAsan.Native.Dialogs.ExpenseEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="هزینه" Width="530" Height="515" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft" Background="{DynamicResource AppBackground}">
    <Border Margin="18" Style="{StaticResource Card}"><StackPanel>
        <TextBlock x:Name="TitleText" Text="ثبت هزینه" FontSize="21" FontWeight="Bold" Margin="0,0,0,18"/>
        <TextBlock Text="عنوان" Style="{StaticResource SmallMuted}"/><TextBox x:Name="NameBox" Style="{StaticResource Input}" Margin="0,5,0,12"/>
        <TextBlock Text="دسته" Style="{StaticResource SmallMuted}"/><TextBox x:Name="CategoryBox" Style="{StaticResource Input}" Margin="0,5,0,12"/>
        <TextBlock Text="مبلغ" Style="{StaticResource SmallMuted}"/><TextBox x:Name="AmountBox" Style="{StaticResource Input}" FlowDirection="LeftToRight" Margin="0,5,0,12"/>
        <TextBlock Text="یادداشت" Style="{StaticResource SmallMuted}"/><TextBox x:Name="NoteBox" Height="80" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,5,0,18"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"><Button Content="انصراف" Width="96" Style="{StaticResource SecondaryButton}" Margin="6,0" Click="Cancel_Click"/><Button Content="ذخیره" Width="110" Style="{StaticResource PrimaryButton}" Margin="6,0" Click="Save_Click"/></StackPanel>
    </StackPanel></Border>
</Window>
