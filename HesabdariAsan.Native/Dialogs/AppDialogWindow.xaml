<Window x:Class="HesabdariAsan.Native.Dialogs.AppDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="470" SizeToContent="Height" MaxHeight="650" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" FlowDirection="RightToLeft">
    <Grid Margin="18" Opacity="0" x:Name="Root">
        <Grid.RenderTransform><TranslateTransform Y="14"/></Grid.RenderTransform>
        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                CornerRadius="18" Padding="22" Effect="{DynamicResource CardShadow}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
                    <Border x:Name="IconHost" Width="44" Height="44" CornerRadius="14" Background="{DynamicResource AccentSoft}" VerticalAlignment="Top">
                        <TextBlock x:Name="IconText" Text="i" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,1,8,0">
                        <TextBlock x:Name="TitleText" FontSize="17" FontWeight="Bold" TextWrapping="Wrap"/>
                        <TextBlock Text="حسابداری آسان" Style="{StaticResource SmallMuted}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="×" Click="Close_Click" Style="{StaticResource IconButton}" Width="30" Height="30" MinHeight="30" FontSize="18" Padding="0"/>
                </Grid>
                <ScrollViewer Grid.Row="1" MaxHeight="360" VerticalScrollBarVisibility="Auto" Margin="0,18,0,18">
                    <TextBlock x:Name="MessageText" FontSize="12.5" LineHeight="22" TextWrapping="Wrap" Foreground="{DynamicResource MutedStrong}"/>
                </ScrollViewer>
                <StackPanel x:Name="ButtonsPanel" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left"/>
            </Grid>
        </Border>
    </Grid>
</Window>
