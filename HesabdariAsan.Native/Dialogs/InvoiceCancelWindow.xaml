<Window x:Class="HesabdariAsan.Native.Dialogs.InvoiceCancelWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ابطال فاکتور" Width="560" Height="380" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" FlowDirection="RightToLeft" Background="{DynamicResource AppBackground}">
 <Border Style="{StaticResource DialogCard}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Padding="22,20" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="عملیات حساس" Foreground="{DynamicResource Danger}" FontSize="10" FontWeight="Bold"/><TextBlock Text="ابطال فاکتور" Style="{StaticResource DialogTitle}"/><TextBlock Text="فاکتور حذف نمی‌شود و سابقه کامل باقی می‌ماند." Style="{StaticResource SmallMuted}"/></StackPanel><Border Grid.Column="1" Width="46" Height="46" CornerRadius="13" Background="{DynamicResource DangerSoft}"><TextBlock Text="!" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource Danger}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></Border>
  <StackPanel Grid.Row="1" Margin="22,18"><Border Background="{DynamicResource DangerSoft}" CornerRadius="10" Padding="11" Margin="0,0,0,14"><TextBlock Text="موجودی و قرض مرتبط طبق قوانین حسابداری برگردانده می‌شود. این عملیات در Audit ثبت خواهد شد." TextWrapping="Wrap" Foreground="{DynamicResource Danger}"/></Border><TextBlock Text="دلیل ابطال" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ReasonBox" Style="{StaticResource Input}" Height="92" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="11,9"/></StackPanel>
  <Border Grid.Row="2" Padding="22,14" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"><StackPanel Orientation="Horizontal" HorizontalAlignment="Left"><Button Content="انصراف" Click="Cancel_Click" Style="{StaticResource SecondaryButton}" Width="95" Margin="0,0,8,0"/><Button Content="ابطال فاکتور" Click="Confirm_Click" Style="{StaticResource DangerButton}" Width="120"/></StackPanel></Border>
 </Grid></Border>
</Window>