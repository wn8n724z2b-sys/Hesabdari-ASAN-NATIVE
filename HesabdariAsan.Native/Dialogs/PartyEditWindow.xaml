<Window x:Class="HesabdariAsan.Native.Dialogs.PartyEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="مشتری / شرکت" Width="540" Height="565" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft" Background="{DynamicResource AppBackground}">
    <Border Margin="18" Style="{StaticResource Card}"><StackPanel>
        <TextBlock x:Name="TitleText" Text="مشتری جدید" FontSize="21" FontWeight="Bold" Margin="0,0,0,18"/>
        <TextBlock Text="نوع" Style="{StaticResource SmallMuted}"/><ComboBox x:Name="TypeBox" Style="{StaticResource Combo}" Margin="0,5,0,12"><ComboBoxItem Content="مشتری" Tag="CUSTOMER"/><ComboBoxItem Content="شرکت / تأمین‌کننده" Tag="COMPANY"/></ComboBox>
        <TextBlock Text="نام" Style="{StaticResource SmallMuted}"/><TextBox x:Name="NameBox" Style="{StaticResource Input}" Margin="0,5,0,12"/>
        <TextBlock Text="شماره تماس" Style="{StaticResource SmallMuted}"/><TextBox x:Name="PhoneBox" Style="{StaticResource Input}" FlowDirection="LeftToRight" Margin="0,5,0,12"/>
        <TextBlock Text="آدرس" Style="{StaticResource SmallMuted}"/><TextBox x:Name="AddressBox" Style="{StaticResource Input}" Margin="0,5,0,12"/>
        <TextBlock Text="قرض فعلی" Style="{StaticResource SmallMuted}"/><TextBox x:Name="DebtBox" Style="{StaticResource Input}" FlowDirection="LeftToRight" Margin="0,5,0,10"/>
        <CheckBox x:Name="PinBox" Content="پین در بالای فهرست" Margin="0,5,0,18"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"><Button Content="انصراف" Width="96" Style="{StaticResource SecondaryButton}" Margin="6,0" Click="Cancel_Click"/><Button Content="ذخیره" Width="110" Style="{StaticResource PrimaryButton}" Margin="6,0" Click="Save_Click"/></StackPanel>
    </StackPanel></Border>
</Window>
