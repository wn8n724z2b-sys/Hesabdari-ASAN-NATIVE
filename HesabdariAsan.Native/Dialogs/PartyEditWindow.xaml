<Window x:Class="HesabdariAsan.Native.Dialogs.PartyEditWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="مشتری / شرکت" Width="620" Height="620" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft" Background="{DynamicResource AppBackground}" Style="{StaticResource ModernDialogWindow}">
 <Border Style="{StaticResource DialogCard}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Padding="22,20,22,17" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="اشخاص" Style="{StaticResource Eyebrow}"/><TextBlock x:Name="TitleText" Text="مشتری جدید" Style="{StaticResource DialogTitle}"/><TextBlock Text="مشخصات و وضعیت حساب" Style="{StaticResource SmallMuted}"/></StackPanel><Border Grid.Column="1" Width="48" Height="48" CornerRadius="14" Background="{DynamicResource AccentSoft}"><Viewbox Width="23" Height="23"><Path Data="{StaticResource IconUsers}" Stroke="{DynamicResource Accent}" StrokeThickness="1.7" Fill="Transparent"/></Viewbox></Border></Grid></Border>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="22,18,22,10">
   <TextBlock Text="نوع حساب" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="TypeBox" Style="{StaticResource Combo}" Margin="0,0,0,14"><ComboBoxItem Content="مشتری" Tag="CUSTOMER"/><ComboBoxItem Content="شرکت / تأمین‌کننده" Tag="COMPANY"/></ComboBox>
   <TextBlock Text="نام" Style="{StaticResource FieldLabel}"/><TextBox x:Name="NameBox" Style="{StaticResource Input}" Margin="0,0,0,14"/>
   <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,7,0"><TextBlock Text="شماره تماس" Style="{StaticResource FieldLabel}"/><TextBox x:Name="PhoneBox" Style="{StaticResource Input}" FlowDirection="LeftToRight" TextAlignment="Left"/></StackPanel><StackPanel Grid.Column="1" Margin="7,0,0,0"><TextBlock Text="قرض فعلی" Style="{StaticResource FieldLabel}"/><TextBox x:Name="DebtBox" Style="{StaticResource Input}" FlowDirection="LeftToRight" TextAlignment="Left"/></StackPanel></Grid>
   <TextBlock Text="آدرس" Style="{StaticResource FieldLabel}"/><TextBox x:Name="AddressBox" Style="{StaticResource Input}" Margin="0,0,0,14"/>
   <Border Background="{DynamicResource SoftSurface}" CornerRadius="11" Padding="12"><CheckBox x:Name="PinBox" Content="نمایش این حساب در بالای فهرست" FontWeight="SemiBold"/></Border>
  </StackPanel></ScrollViewer>
  <Border Grid.Row="2" Padding="22,15" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"><StackPanel Orientation="Horizontal" HorizontalAlignment="Left"><Button Content="انصراف" Width="96" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="Cancel_Click"/><Button Content="ذخیره" Width="110" Style="{StaticResource PrimaryButton}" Click="Save_Click"/></StackPanel></Border>
 </Grid></Border>
</Window>