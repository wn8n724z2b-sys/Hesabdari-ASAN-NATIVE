<Window x:Class="HesabdariAsan.Native.Dialogs.PurchaseEntryWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="ثبت خرید / ورود کالا" Width="760" Height="760" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" FlowDirection="RightToLeft" Background="{DynamicResource AppBackground}" Style="{StaticResource ModernDialogWindow}">
 <Border Style="{StaticResource DialogCard}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Padding="22,20,22,17" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="انبارداری" Style="{StaticResource Eyebrow}"/><TextBlock Text="خرید و ورود کالا" Style="{StaticResource DialogTitle}"/><TextBlock Text="ورود بر اساس واحد فروش یا واحد خرید، با محاسبه خودکار میانگین بهای موجودی" Style="{StaticResource SmallMuted}"/></StackPanel><Border Grid.Column="1" Width="48" Height="48" Background="{DynamicResource AccentSoft}" CornerRadius="14"><Viewbox Width="23" Height="23"><Path Data="{StaticResource IconPurchase}" Stroke="{DynamicResource Accent}" StrokeThickness="1.8" Fill="Transparent"/></Viewbox></Border></Grid></Border>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="22,18,22,12">
   <TextBlock Text="کالا" Style="{StaticResource FieldLabel}"/>
   <Grid><TextBox x:Name="ProductSearchBox" Style="{StaticResource Input}" TextChanged="ProductSearchBox_TextChanged" ToolTip="نام یا بارکد کالا"/><Popup x:Name="ProductPopup" PlacementTarget="{Binding ElementName=ProductSearchBox}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" Width="668"><Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="5" Effect="{DynamicResource CardShadow}"><ListBox x:Name="ProductList" MaxHeight="280" SelectionChanged="ProductList_SelectionChanged" BorderThickness="0" Background="Transparent"><ListBox.ItemTemplate><DataTemplate><Grid Margin="8,7"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding ProductMeta}" Style="{StaticResource SmallMuted}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{Binding StockText}" HorizontalAlignment="Left"/><TextBlock Text="{Binding PurchasePriceText}" Style="{StaticResource SmallMuted}" HorizontalAlignment="Left"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Border></Popup></Grid>
   <TextBlock x:Name="SelectedProductText" Text="کالایی انتخاب نشده" Foreground="{DynamicResource Muted}" Margin="2,5,0,13" FontSize="11.5"/>

   <Border x:Name="UnitModeCard" Background="{DynamicResource SoftSurface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="12" Padding="13" Margin="0,0,0,14">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
     <RadioButton x:Name="BaseModeRadio" Grid.Column="0" Content="ورود با واحد فروش" IsChecked="True" Checked="PurchaseMode_Changed" FontWeight="SemiBold" Margin="4"/>
     <RadioButton x:Name="PurchaseModeRadio" Grid.Column="1" Content="ورود با واحد خرید / بسته" Checked="PurchaseMode_Changed" FontWeight="SemiBold" Margin="4" IsEnabled="False"/>
     <TextBlock x:Name="UnitModeHint" Grid.Row="1" Grid.ColumnSpan="2" Text="بعد از انتخاب کالا، واحدها و تبدیل اینجا نمایش داده می‌شود." Style="{StaticResource SmallMuted}" Margin="4,8,4,0"/>
    </Grid>
   </Border>

   <TextBlock Text="شرکت / تأمین‌کننده" Style="{StaticResource FieldLabel}"/>
   <Grid><TextBox x:Name="SupplierSearchBox" Style="{StaticResource Input}" TextChanged="SupplierSearchBox_TextChanged" ToolTip="نام یا تلفن شرکت"/><Popup x:Name="SupplierPopup" PlacementTarget="{Binding ElementName=SupplierSearchBox}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" Width="668"><Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="5" Effect="{DynamicResource CardShadow}"><ListBox x:Name="SupplierList" MaxHeight="250" SelectionChanged="SupplierList_SelectionChanged" BorderThickness="0" Background="Transparent"><ListBox.ItemTemplate><DataTemplate><Grid Margin="8,7"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Phone}" Style="{StaticResource SmallMuted}"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding DebtText}" Foreground="{DynamicResource Warning}"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Border></Popup></Grid>
   <TextBlock x:Name="SelectedSupplierText" Text="بدون شرکت (برای خرید نقدی اختیاری)" Foreground="{DynamicResource Muted}" Margin="2,5,0,13" FontSize="11.5"/>

   <Grid Margin="0,0,0,13"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
    <StackPanel Margin="0,0,7,0"><TextBlock x:Name="QuantityLabel" Text="تعداد واحد" Style="{StaticResource FieldLabel}"/><TextBox x:Name="QuantityBox" Text="1" Style="{StaticResource Input}" FlowDirection="LeftToRight" TextAlignment="Left" TextChanged="PurchaseValue_Changed"/></StackPanel>
    <StackPanel Grid.Column="1" Margin="7,0,0,0"><TextBlock x:Name="CostLabel" Text="قیمت خرید هر واحد" Style="{StaticResource FieldLabel}"/><TextBox x:Name="UnitCostBox" Text="0" Style="{StaticResource Input}" FlowDirection="LeftToRight" TextAlignment="Left" TextChanged="PurchaseValue_Changed"/></StackPanel>
   </Grid>

   <Border Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="12" Padding="13" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="ورودی واقعی انبار" Style="{StaticResource SmallMuted}"/><TextBlock x:Name="IncomingUnitsText" Text="—" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel>
    <StackPanel Grid.Column="1"><TextBlock Text="بهای واحد محاسبه‌شده" Style="{StaticResource SmallMuted}"/><TextBlock x:Name="CalculatedUnitCostText" Text="—" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel>
    <StackPanel Grid.Column="2"><TextBlock Text="مجموع خرید" Style="{StaticResource SmallMuted}"/><TextBlock x:Name="PurchaseTotalText" Text="—" FontWeight="Bold" Foreground="{DynamicResource Accent}" Margin="0,4,0,0"/></StackPanel>
   </Grid></Border>

   <TextBlock Text="روش پرداخت" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="PaymentBox" Style="{StaticResource Combo}" Margin="0,0,0,14" SelectionChanged="PaymentBox_SelectionChanged"><ComboBoxItem Content="نقدی" IsSelected="True"/><ComboBoxItem Content="نسیه"/></ComboBox>
   <TextBlock Text="یادداشت" Style="{StaticResource FieldLabel}"/><TextBox x:Name="NoteBox" Style="{StaticResource Input}" Height="68" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="11,9"/>
   <Border Background="{DynamicResource SuccessSoft}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="11" Margin="0,14,0,0"><TextBlock Text="موجودی با واحد پایه نگهداری می‌شود. بهای خرید جدید با روش میانگین موزون محاسبه می‌شود و خرید نسیه نیز همان لحظه به حساب تأمین‌کننده اضافه می‌گردد." TextWrapping="Wrap" Foreground="{DynamicResource Success}"/></Border>
  </StackPanel></ScrollViewer>
  <Border Grid.Row="2" Padding="22,15" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"><StackPanel Orientation="Horizontal" HorizontalAlignment="Left"><Button Content="انصراف" Click="Cancel_Click" Style="{StaticResource SecondaryButton}" Width="96" Margin="0,0,8,0"/><Button Content="ثبت خرید" Click="Save_Click" Style="{StaticResource PrimaryButton}" Width="118"/></StackPanel></Border>
 </Grid></Border>
</Window>
