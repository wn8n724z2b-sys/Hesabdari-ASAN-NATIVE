<Window x:Class="HesabdariAsan.Native.Dialogs.PurchaseEntryWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="ثبت خرید / ورود کالا" Width="640" Height="650" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" FlowDirection="RightToLeft">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="ثبت خرید / ورود کالا" Style="{StaticResource PageTitle}"/>
  <StackPanel Grid.Row="1" Margin="0,0,0,12"><TextBlock Text="کالا" Style="{StaticResource SmallMuted}"/><Grid Margin="0,5,0,0"><TextBox x:Name="ProductSearchBox" Style="{StaticResource Input}" TextChanged="ProductSearchBox_TextChanged" ToolTip="نام یا بارکد کالا"/><Popup x:Name="ProductPopup" PlacementTarget="{Binding ElementName=ProductSearchBox}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" Width="560"><Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="5"><ListBox x:Name="ProductList" MaxHeight="300" SelectionChanged="ProductList_SelectionChanged" BorderThickness="0" Background="Transparent" DisplayMemberPath="Name"/></Border></Popup></Grid><TextBlock x:Name="SelectedProductText" Text="کالایی انتخاب نشده" Foreground="{DynamicResource Muted}" Margin="0,5,0,0"/></StackPanel>
  <StackPanel Grid.Row="2" Margin="0,0,0,12"><TextBlock Text="شرکت / تأمین‌کننده" Style="{StaticResource SmallMuted}"/><Grid Margin="0,5,0,0"><TextBox x:Name="SupplierSearchBox" Style="{StaticResource Input}" TextChanged="SupplierSearchBox_TextChanged" ToolTip="نام یا تلفن شرکت"/><Popup x:Name="SupplierPopup" PlacementTarget="{Binding ElementName=SupplierSearchBox}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" Width="560"><Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="5"><ListBox x:Name="SupplierList" MaxHeight="250" SelectionChanged="SupplierList_SelectionChanged" BorderThickness="0" Background="Transparent" DisplayMemberPath="Name"/></Border></Popup></Grid><TextBlock x:Name="SelectedSupplierText" Text="بدون شرکت (برای خرید نقدی اختیاری)" Foreground="{DynamicResource Muted}" Margin="0,5,0,0"/></StackPanel>
  <Grid Grid.Row="3" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,6,0"><TextBlock Text="تعداد" Style="{StaticResource SmallMuted}"/><TextBox x:Name="QuantityBox" Text="1" Style="{StaticResource Input}" Margin="0,5,0,0" FlowDirection="LeftToRight"/></StackPanel><StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="قیمت خرید هر واحد" Style="{StaticResource SmallMuted}"/><TextBox x:Name="UnitCostBox" Text="0" Style="{StaticResource Input}" Margin="0,5,0,0" FlowDirection="LeftToRight"/></StackPanel></Grid>
  <StackPanel Grid.Row="4" Margin="0,0,0,12"><TextBlock Text="روش پرداخت" Style="{StaticResource SmallMuted}"/><ComboBox x:Name="PaymentBox" Style="{StaticResource Combo}" Margin="0,5,0,0"><ComboBoxItem Content="نقدی" IsSelected="True"/><ComboBoxItem Content="نسیه"/></ComboBox></StackPanel>
  <StackPanel Grid.Row="5" Margin="0,0,0,12"><TextBlock Text="یادداشت" Style="{StaticResource SmallMuted}"/><TextBox x:Name="NoteBox" Style="{StaticResource Input}" Margin="0,5,0,0"/></StackPanel>
  <Border Grid.Row="6" Background="{DynamicResource SoftSurface}" CornerRadius="10" Padding="12" Margin="0,0,0,12"><TextBlock Text="با ثبت خرید، موجودی کالا افزایش می‌یابد؛ در خرید نسیه قرض شرکت نیز هم‌زمان ثبت می‌شود." TextWrapping="Wrap" Foreground="{DynamicResource Muted}"/></Border>
  <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Left"><Button Content="انصراف" Click="Cancel_Click" Style="{StaticResource SecondaryButton}" Margin="5,0"/><Button Content="ثبت خرید" Click="Save_Click" Style="{StaticResource PrimaryButton}" Margin="5,0"/></StackPanel>
 </Grid>
</Window>
