<Window x:Class="HesabdariAsan.Native.Dialogs.InventoryAdjustWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="اصلاح موجودی" Width="610" Height="570" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" FlowDirection="RightToLeft" Background="{DynamicResource AppBackground}" Style="{StaticResource ModernDialogWindow}">
 <Border Style="{StaticResource DialogCard}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Padding="22,20,22,17" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"><StackPanel><TextBlock Text="انبارداری" Style="{StaticResource Eyebrow}"/><TextBlock Text="اصلاح موجودی" Style="{StaticResource DialogTitle}"/><TextBlock Text="اصلاح دستی با ثبت کامل در کاردکس و رویدادها" Style="{StaticResource SmallMuted}"/></StackPanel></Border>
  <StackPanel Grid.Row="1" Margin="22,18">
   <TextBlock Text="کالا" Style="{StaticResource FieldLabel}"/>
   <Grid><TextBox x:Name="ProductSearchBox" Style="{StaticResource Input}" TextChanged="ProductSearchBox_TextChanged" ToolTip="نام یا بارکد کالا"/><Popup x:Name="ProductPopup" PlacementTarget="{Binding ElementName=ProductSearchBox}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" Width="522"><Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="5" Effect="{DynamicResource CardShadow}"><ListBox x:Name="ProductList" MaxHeight="250" SelectionChanged="ProductList_SelectionChanged" BorderThickness="0" Background="Transparent"><ListBox.ItemTemplate><DataTemplate><Grid Margin="8,7"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding StockText}" Foreground="{DynamicResource Muted}"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Border></Popup></Grid>
   <TextBlock x:Name="CurrentStockText" Text="کالایی انتخاب نشده" Style="{StaticResource SmallMuted}" Margin="2,5,0,16"/>
   <TextBlock Text="موجودی واقعی جدید" Style="{StaticResource FieldLabel}"/><TextBox x:Name="NewStockBox" Style="{StaticResource Input}" Text="0" FlowDirection="LeftToRight" TextAlignment="Left" TextChanged="NewStockBox_TextChanged"/>
   <Border Background="{DynamicResource SoftSurface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,9,0,15"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="تغییر" Style="{StaticResource SmallMuted}"/><TextBlock x:Name="DeltaText" Text="—" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="بعد از اصلاح" Style="{StaticResource SmallMuted}"/><TextBlock x:Name="AfterText" Text="—" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel></Grid></Border>
   <TextBlock Text="دلیل اصلاح" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ReasonBox" Style="{StaticResource Input}" Height="72" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="11,9" ToolTip="مثلاً شمارش فیزیکی انبار، شکستگی، کسری یا اصلاح ثبت"/>
   <Border Background="{DynamicResource WarningSoft}" CornerRadius="10" Padding="11" Margin="0,14,0,0"><TextBlock Text="این عملیات حذف نمی‌شود؛ مقدار قبل، مقدار بعد، اختلاف و دلیل در کاردکس و Audit ثبت خواهد شد." TextWrapping="Wrap" Foreground="{DynamicResource Warning}"/></Border>
  </StackPanel>
  <Border Grid.Row="2" Padding="22,15" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"><StackPanel Orientation="Horizontal" HorizontalAlignment="Left"><Button Content="انصراف" Click="Cancel_Click" Style="{StaticResource SecondaryButton}" Width="96" Margin="0,0,8,0"/><Button Content="ثبت اصلاح" Click="Save_Click" Style="{StaticResource PrimaryButton}" Width="118"/></StackPanel></Border>
 </Grid></Border>
</Window>
