<Window x:Class="HesabdariAsan.Native.Dialogs.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="راه‌اندازی حسابداری آسان" Width="820" Height="760" MinWidth="760" MinHeight="680"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize" FlowDirection="RightToLeft"
        Background="{DynamicResource AppBackground}" Icon="../Assets/app.ico">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Width="58" Height="58" CornerRadius="16" Background="{DynamicResource Accent}" VerticalAlignment="Center">
                <Viewbox Width="30" Height="30"><Path Data="{StaticResource IconHome}" Stroke="White" StrokeThickness="1.7" Fill="Transparent"/></Viewbox>
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="حسابداری آسان" FontSize="23" FontWeight="Bold"/>
                <TextBlock Text="راه‌اندازی اولیه · چند تنظیم ضروری و بعد برنامه آماده استفاده است" Style="{StaticResource SmallMuted}" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="هویت فروشگاه" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="نام فروشگاه الزامی است؛ آدرس و تماس اختیاری‌اند." Style="{StaticResource SmallMuted}" Margin="0,3,0,12"/>
                        <TextBlock Text="نام فروشگاه" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="StoreNameBox" Style="{StaticResource Input}"/>
                        <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0"><TextBlock Text="آدرس" Style="{StaticResource FieldLabel}"/><TextBox x:Name="AddressBox" Style="{StaticResource Input}"/></StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="شماره تماس" Style="{StaticResource FieldLabel}"/><TextBox x:Name="PhoneBox" Style="{StaticResource Input}" FlowDirection="LeftToRight" TextAlignment="Right"/></StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="رمز مدیر" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="برای حفاظت Backup، بازیابی و تنظیمات حساس؛ حداقل 4 کاراکتر." Style="{StaticResource SmallMuted}" Margin="0,3,0,12"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0"><TextBlock Text="رمز مدیر" Style="{StaticResource FieldLabel}"/><PasswordBox x:Name="PasswordBox" Height="40" Padding="11" VerticalContentAlignment="Center"/></StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="تکرار رمز" Style="{StaticResource FieldLabel}"/><PasswordBox x:Name="ConfirmPasswordBox" Height="40" Padding="11" VerticalContentAlignment="Center"/></StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="ظاهر و تجهیزات" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="این موارد بعداً از تنظیمات نیز قابل تغییر هستند." Style="{StaticResource SmallMuted}" Margin="0,3,0,12"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0"><TextBlock Text="ظاهر" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="ThemeBox" Style="{StaticResource Combo}"><ComboBoxItem Content="روشن" Tag="Light" IsSelected="True"/><ComboBoxItem Content="دارک" Tag="Dark"/></ComboBox></StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0"><TextBlock Text="Backup خودکار" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="BackupBox" Style="{StaticResource Combo}" SelectedIndex="3"><ComboBoxItem Content="1 بار در روز" Tag="1"/><ComboBoxItem Content="2 بار در روز" Tag="2"/><ComboBoxItem Content="3 بار در روز" Tag="3"/><ComboBoxItem Content="4 بار در روز" Tag="4"/><ComboBoxItem Content="5 بار در روز" Tag="5"/><ComboBoxItem Content="6 بار در روز" Tag="6"/></ComboBox></StackPanel>
                            <StackPanel Grid.Column="2" Margin="6,0,0,0"><TextBlock Text="پرینتر" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="PrinterBox" Style="{StaticResource Combo}" IsEditable="True"/></StackPanel>
                        </Grid>
                        <Button Content="شناسایی پرینترهای Windows" Click="DetectPrinters_Click" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Danger}" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <Button Grid.Column="1" Content="شروع استفاده از حسابداری آسان" Click="Finish_Click" Style="{StaticResource PrimaryButton}" Height="44" Padding="24,0"/>
        </Grid>
    </Grid>
</Window>
