<Window x:Class="HesabdariAsan.Native.Dialogs.DebtPaymentWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="تسویه قرض" Width="500" Height="355" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft" Background="{DynamicResource AppBackground}">
 <Border Style="{StaticResource DialogCard}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Padding="21,19" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"><StackPanel><TextBlock Text="حساب" Style="{StaticResource Eyebrow}"/><TextBlock x:Name="TitleText" Style="{StaticResource DialogTitle}"/><TextBlock x:Name="CustomerText" Style="{StaticResource SmallMuted}"/></StackPanel></Border>
  <StackPanel Grid.Row="1" Margin="21,18"><TextBlock Text="مبلغ پرداخت" Style="{StaticResource FieldLabel}"/><TextBox x:Name="AmountBox" Style="{StaticResource Input}" FlowDirection="LeftToRight" TextAlignment="Left"/><Border Margin="0,12,0,0" Background="{DynamicResource AccentSoft}" CornerRadius="10" Padding="10"><TextBlock Text="مبلغ پس از ثبت، مستقیم در مانده حساب اعمال می‌شود." Foreground="{DynamicResource Accent}" FontSize="11.5"/></Border></StackPanel>
  <Border Grid.Row="2" Padding="21,14" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"><StackPanel Orientation="Horizontal" HorizontalAlignment="Left"><Button Content="انصراف" Style="{StaticResource SecondaryButton}" Width="92" Margin="0,0,8,0" Click="Cancel_Click"/><Button Content="ثبت پرداخت" Style="{StaticResource PrimaryButton}" Width="116" Click="Save_Click"/></StackPanel></Border>
 </Grid></Border>
</Window>