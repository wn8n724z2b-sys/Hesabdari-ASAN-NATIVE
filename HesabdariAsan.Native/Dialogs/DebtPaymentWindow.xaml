 <Border Margin="18" Style="{StaticResource Card}"><StackPanel><TextBlock x:Name="TitleText" FontSize="20" FontWeight="Bold"/><TextBlock x:Name="CustomerText" Margin="0,7,0,14" Foreground="{DynamicResource Muted}"/><TextBlock Text="مبلغ پرداخت" Style="{StaticResource SmallMuted}"/><TextBox x:Name="AmountBox" Style="{StaticResource Input}" FlowDirection="LeftToRight" Margin="0,5,0,16"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Left"><Button Content="انصراف" Style="{StaticResource SecondaryButton}" Width="90" Margin="5" Click="Cancel_Click"/><Button Content="ثبت پرداخت" Style="{StaticResource PrimaryButton}" Width="110" Margin="5" Click="Save_Click"/></StackPanel></StackPanel></Border>
