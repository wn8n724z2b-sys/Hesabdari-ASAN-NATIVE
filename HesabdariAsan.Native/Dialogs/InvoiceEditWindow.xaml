<Window x:Class="HesabdariAsan.Native.Dialogs.InvoiceEditWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="ویرایش فاکتور" Width="820" Height="650" WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="ویرایش امن فاکتور" Style="{StaticResource PageTitle}"/><TextBlock x:Name="InfoText" Foreground="{DynamicResource Muted}"/></StackPanel>
  <Border Grid.Row="1" Background="{DynamicResource SoftSurface}" CornerRadius="10" Padding="12" Margin="0,0,0,12"><TextBlock Text="در این مرحله تعداد، قیمت فروش و تخفیف قابل اصلاح است. موجودی و قرض مشتری هنگام ذخیره، داخل یک Transaction برگشت و دوباره محاسبه می‌شود." TextWrapping="Wrap"/></Border>
  <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0"><DataGrid x:Name="ItemsGrid" ItemsSource="{Binding Items}" Style="{StaticResource GridStyle}" CanUserAddRows="False"><DataGrid.Columns>
   <DataGridTextColumn Header="کالا" Binding="{Binding ProductName}" Width="2*" IsReadOnly="True"/>
   <DataGridTextColumn Header="بارکد" Binding="{Binding Barcode}" Width="150" IsReadOnly="True"/>
   <DataGridTextColumn Header="تعداد" Binding="{Binding Quantity,UpdateSourceTrigger=PropertyChanged}" Width="100"/>
   <DataGridTextColumn Header="فی فروش" Binding="{Binding UnitPrice,UpdateSourceTrigger=PropertyChanged}" Width="120"/>
   <DataGridTextColumn Header="جمع" Binding="{Binding LineTotal}" Width="120" IsReadOnly="True"/>
   <DataGridTemplateColumn Header="" Width="80"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="حذف" Tag="{Binding}" Click="RemoveLine_Click" Style="{StaticResource DangerButton}" Padding="8,4"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
  </DataGrid.Columns></DataGrid></Border>
  <Grid Grid.Row="3" Margin="0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><TextBlock x:Name="TotalText" VerticalAlignment="Center" FontWeight="Bold" FontSize="18"/><StackPanel Grid.Column="1"><TextBlock Text="تخفیف" Style="{StaticResource SmallMuted}"/><TextBox x:Name="DiscountBox" Text="{Binding Discount,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" FlowDirection="LeftToRight"/></StackPanel></Grid>
  <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Left"><Button Content="انصراف" Click="Cancel_Click" Style="{StaticResource SecondaryButton}" Margin="5,0"/><Button Content="ذخیره تغییرات" Click="Save_Click" Style="{StaticResource PrimaryButton}" Margin="5,0"/></StackPanel>
 </Grid>
</Window>
