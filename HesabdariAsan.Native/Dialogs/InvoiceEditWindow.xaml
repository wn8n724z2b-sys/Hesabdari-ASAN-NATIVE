<Window x:Class="HesabdariAsan.Native.Dialogs.InvoiceEditWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="ویرایش فاکتور" Width="900" Height="690" MinWidth="820" MinHeight="620" WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft" Background="{DynamicResource AppBackground}">
 <Border Margin="18" Style="{StaticResource Card}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Padding="22,19" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="ویرایش امن" Style="{StaticResource Eyebrow}"/><TextBlock Text="ویرایش فاکتور" Style="{StaticResource DialogTitle}"/><TextBlock x:Name="InfoText" Style="{StaticResource SmallMuted}"/></StackPanel><Border Grid.Column="1" Background="{DynamicResource WarningSoft}" CornerRadius="999" Padding="12,6" VerticalAlignment="Center"><TextBlock Text="ثبت با Transaction" Foreground="{DynamicResource Warning}" FontWeight="SemiBold" FontSize="11"/></Border></Grid></Border>
  <Border Grid.Row="1" Background="{DynamicResource SoftSurface}" CornerRadius="10" Padding="12" Margin="22,14,22,12"><TextBlock Text="تعداد، قیمت فروش، حذف قلم و تخفیف قابل اصلاح است. موجودی و حساب مشتری به صورت اتمیک دوباره محاسبه می‌شود." TextWrapping="Wrap" Foreground="{DynamicResource MutedStrong}"/></Border>
  <DataGrid Grid.Row="2" x:Name="ItemsGrid" ItemsSource="{Binding Items}" Style="{StaticResource GridStyle}" Margin="0,0,0,0" CanUserAddRows="False"><DataGrid.Columns>
   <DataGridTextColumn Header="کالا" Binding="{Binding ProductName}" Width="2*" IsReadOnly="True"/><DataGridTextColumn Header="بارکد" Binding="{Binding Barcode}" Width="145" IsReadOnly="True"/><DataGridTextColumn Header="تعداد" Binding="{Binding Quantity,UpdateSourceTrigger=PropertyChanged}" Width="95"/><DataGridTextColumn Header="فی فروش" Binding="{Binding UnitPrice,UpdateSourceTrigger=PropertyChanged}" Width="115"/><DataGridTextColumn Header="جمع" Binding="{Binding LineTotal}" Width="115" IsReadOnly="True"/><DataGridTemplateColumn Header="عملیات" Width="85"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="حذف" Tag="{Binding}" Click="RemoveLine_Click" Style="{StaticResource DangerButton}" Height="30" MinHeight="30" Padding="9,0" FontSize="10"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
  </DataGrid.Columns></DataGrid>
  <Border Grid.Row="3" Padding="22,14" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="160"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="جمع اقلام" Style="{StaticResource SmallMuted}"/><TextBlock x:Name="TotalText" FontWeight="Bold" FontSize="18" FlowDirection="LeftToRight" HorizontalAlignment="Right"/></StackPanel><StackPanel Grid.Column="1" Margin="12,0"><TextBlock Text="تخفیف" Style="{StaticResource FieldLabel}"/><TextBox x:Name="DiscountBox" Text="{Binding Discount,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" FlowDirection="LeftToRight" TextAlignment="Left"/></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom"><Button Content="انصراف" Click="Cancel_Click" Style="{StaticResource SecondaryButton}" Width="95" Margin="0,0,8,0"/><Button Content="ذخیره تغییرات" Click="Save_Click" Style="{StaticResource PrimaryButton}" Width="126"/></StackPanel></Grid></Border>
 </Grid></Border>
</Window>