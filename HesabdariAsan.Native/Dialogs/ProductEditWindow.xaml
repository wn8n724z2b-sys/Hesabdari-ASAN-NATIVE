<Window x:Class="HesabdariAsan.Native.Dialogs.ProductEditWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="کالا" Width="650" Height="675" MinWidth="650" MinHeight="675" ResizeMode="NoResize"
 WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft" Background="{DynamicResource AppBackground}">
 <Grid>
  <Border Style="{StaticResource DialogCard}" Padding="0">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Padding="22,20,22,17" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="مدیریت کالا" Style="{StaticResource Eyebrow}"/><TextBlock x:Name="TitleText" Text="کالای جدید" Style="{StaticResource DialogTitle}"/><TextBlock Text="مشخصات اصلی، قیمت و موجودی کالا" Style="{StaticResource SmallMuted}"/></StackPanel>
      <Border Grid.Column="1" Width="48" Height="48" CornerRadius="14" Background="{DynamicResource AccentSoft}" VerticalAlignment="Center"><Viewbox Width="23" Height="23"><Path Data="{StaticResource IconBox}" Stroke="{DynamicResource Accent}" StrokeThickness="1.7" Fill="Transparent"/></Viewbox></Border>
     </Grid>
    </Border>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="22,18,22,8">
      <TextBlock Text="نام کالا" Style="{StaticResource FieldLabel}"/><TextBox x:Name="NameBox" Style="{StaticResource Input}" Margin="0,0,0,14"/>
      <TextBlock Text="بارکد اصلی" Style="{StaticResource FieldLabel}"/><TextBox x:Name="BarcodeBox" Style="{StaticResource Input}" FlowDirection="LeftToRight" TextAlignment="Left" Margin="0,0,0,14"/>
      <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
       <StackPanel Margin="0,0,7,0"><TextBlock Text="دسته" Style="{StaticResource FieldLabel}"/><TextBox x:Name="CategoryBox" Style="{StaticResource Input}"/></StackPanel>
       <StackPanel Grid.Column="1" Margin="7,0,0,0"><TextBlock Text="واحد" Style="{StaticResource FieldLabel}"/><TextBox x:Name="UnitBox" Style="{StaticResource Input}"/></StackPanel>
      </Grid>
      <Border Background="{DynamicResource SoftSurface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,14">
       <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,7,0"><TextBlock Text="قیمت خرید" Style="{StaticResource FieldLabel}"/><TextBox x:Name="PurchaseBox" Style="{StaticResource Input}" FlowDirection="LeftToRight" TextAlignment="Left"/></StackPanel>
        <StackPanel Grid.Column="1" Margin="7,0,0,0"><TextBlock Text="قیمت فروش" Style="{StaticResource FieldLabel}"/><TextBox x:Name="SaleBox" Style="{StaticResource Input}" FlowDirection="LeftToRight" TextAlignment="Left"/></StackPanel>
       </Grid>
      </Border>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
       <StackPanel Margin="0,0,7,0"><TextBlock Text="موجودی فعلی" Style="{StaticResource FieldLabel}"/><TextBox x:Name="StockBox" Style="{StaticResource Input}" FlowDirection="LeftToRight" TextAlignment="Left"/></StackPanel>
       <StackPanel Grid.Column="1" Margin="7,0,0,0"><TextBlock Text="حداقل موجودی" Style="{StaticResource FieldLabel}"/><TextBox x:Name="MinStockBox" Style="{StaticResource Input}" FlowDirection="LeftToRight" TextAlignment="Left"/></StackPanel>
      </Grid>
    </StackPanel></ScrollViewer>
    <Border Grid.Row="2" Padding="22,15" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Background="{DynamicResource Surface}">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="اطلاعات با ذخیره مستقیماً در دیتابیس ثبت می‌شود." Style="{StaticResource SmallMuted}" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="انصراف" Width="96" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="Cancel_Click"/><Button Content="ذخیره کالا" Width="118" Style="{StaticResource PrimaryButton}" Click="Save_Click"/></StackPanel></Grid>
    </Border>
   </Grid>
  </Border>
 </Grid>
</Window>