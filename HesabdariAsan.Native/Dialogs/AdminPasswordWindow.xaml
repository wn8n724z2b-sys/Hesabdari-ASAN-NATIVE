<Window x:Class="HesabdariAsan.Native.Dialogs.AdminPasswordWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="رمز مدیر" Width="450" Height="390" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft" Background="{DynamicResource AppBackground}" Style="{StaticResource ModernDialogWindow}">
 <Border Style="{StaticResource DialogCard}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="امنیت" Style="{StaticResource Eyebrow}"/><TextBlock Text="تغییر رمز مدیر" Style="{StaticResource DialogTitle}"/><TextBlock Text="این رمز برای بخش داده‌ها و پشتیبانی استفاده می‌شود." Style="{StaticResource SmallMuted}"/></StackPanel>
  <StackPanel Grid.Row="1" Margin="0,18,0,10"><StackPanel x:Name="CurrentPanel"><TextBlock Text="رمز فعلی" Style="{StaticResource FieldLabel}"/><PasswordBox x:Name="CurrentPassword" Height="40" Padding="10" Margin="0,0,0,12"/></StackPanel><TextBlock Text="رمز جدید" Style="{StaticResource FieldLabel}"/><PasswordBox x:Name="NewPassword" Height="40" Padding="10" Margin="0,0,0,12"/><TextBlock Text="تکرار رمز جدید" Style="{StaticResource FieldLabel}"/><PasswordBox x:Name="ConfirmPassword" Height="40" Padding="10"/></StackPanel>
  <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left"><Button Content="انصراف" Click="Cancel_Click" Style="{StaticResource SecondaryButton}" Width="90" Margin="0,0,8,0"/><Button Content="ذخیره رمز" Click="Save_Click" Style="{StaticResource PrimaryButton}" Width="110"/></StackPanel>
 </Grid></Border>
</Window>
