<Window x:Class="HesabdariAsan.Native.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="حسابداری آسان" Height="840" Width="1420" MinHeight="720" MinWidth="1160"
        WindowStartupLocation="CenterScreen" FlowDirection="RightToLeft" Icon="Assets/app.ico">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="18">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Width="500" HorizontalAlignment="Right">
                        <TextBox x:Name="SearchBox" Text="{Binding GlobalQuery,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" Padding="40,0,12,0" ToolTip="جستجو در کالا، مشتری، شرکت و فاکتور"/>
                        <TextBlock Text="⌕" FontSize="22" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="12,0,0,0" IsHitTestVisible="False"/>
                        <Popup IsOpen="{Binding IsSearchOpen}" PlacementTarget="{Binding ElementName=SearchBox}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" Width="500">
                            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="12" Padding="8" Margin="0,6,0,0">
                                <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding SearchResults}">
                                        <ItemsControl.ItemTemplate><DataTemplate>
                                            <Button Command="{Binding DataContext.SearchHitCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Padding="10" HorizontalContentAlignment="Stretch">
                                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Background="{DynamicResource AccentSoft}" CornerRadius="8" Padding="7"><TextBlock Text="{Binding Kind}" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/></Border>
                                                    <StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Subtitle}" Style="{StaticResource SmallMuted}" Margin="0,3,0,0"/></StackPanel>
                                                </Grid>
                                            </Button>
                                        </DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <Border Grid.Column="1" Margin="10,0" Padding="14,9" CornerRadius="12" Background="{DynamicResource SoftSurface}"><StackPanel Orientation="Horizontal"><TextBlock Text="ساعت سیستم" Foreground="{DynamicResource Muted}" Margin="0,0,9,0"/><TextBlock x:Name="ClockText" FontWeight="Bold" FlowDirection="LeftToRight"/></StackPanel></Border>
                    <Border Grid.Column="2" Padding="14,9" CornerRadius="12" Background="{DynamicResource SoftSurface}"><StackPanel Orientation="Horizontal"><TextBlock Text="ساعات کاری" Foreground="{DynamicResource Muted}" Margin="0,0,9,0"/><TextBlock x:Name="WorkText" FontWeight="Bold" FlowDirection="LeftToRight"/></StackPanel></Border>
                </Grid>
            </Border>
            <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" Margin="0,16,0,0"/>
        </Grid>

        <Border Grid.Column="1" Background="{DynamicResource Sidebar}" Padding="14">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Margin="5,4,5,17">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Border Width="46" Height="46" CornerRadius="13" Background="{DynamicResource Accent}" Padding="5"><Image Source="Assets/app.ico" Stretch="Uniform"/></Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="حسابداری آسان" FontSize="18" FontWeight="Bold"/><TextBlock Text="Native v4" Style="{StaticResource SmallMuted}"/></StackPanel>
                    </StackPanel>
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Dashboard"><StackPanel Orientation="Horizontal"><TextBlock Text="⌂" FontSize="22" Width="34"/><TextBlock Text="داشبورد" VerticalAlignment="Center"/></StackPanel></Button>
                        <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Sales"><StackPanel Orientation="Horizontal"><TextBlock Text="◫" FontSize="22" Width="34"/><TextBlock Text="فروش" VerticalAlignment="Center"/></StackPanel></Button>
                        <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Products"><StackPanel Orientation="Horizontal"><TextBlock Text="◇" FontSize="22" Width="34"/><TextBlock Text="کالاها" VerticalAlignment="Center"/></StackPanel></Button>
                        <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Purchases"><StackPanel Orientation="Horizontal"><TextBlock Text="⇩" FontSize="22" Width="34"/><TextBlock Text="خرید و ورود کالا" VerticalAlignment="Center"/></StackPanel></Button>
                        <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Parties"><StackPanel Orientation="Horizontal"><TextBlock Text="◎" FontSize="22" Width="34"/><TextBlock Text="مشتریان و شرکت‌ها" VerticalAlignment="Center"/></StackPanel></Button>
                        <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Expenses"><StackPanel Orientation="Horizontal"><TextBlock Text="−" FontSize="24" Width="34"/><TextBlock Text="هزینه‌ها" VerticalAlignment="Center"/></StackPanel></Button>
                        <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Inventory"><StackPanel Orientation="Horizontal"><TextBlock Text="▦" FontSize="21" Width="34"/><TextBlock Text="انبار" VerticalAlignment="Center"/></StackPanel></Button>
                        <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Reports"><StackPanel Orientation="Horizontal"><TextBlock Text="⌁" FontSize="22" Width="34"/><TextBlock Text="گزارش‌ها" VerticalAlignment="Center"/></StackPanel></Button>
                        <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Audit"><StackPanel Orientation="Horizontal"><TextBlock Text="◴" FontSize="21" Width="34"/><TextBlock Text="ثبت رویدادها" VerticalAlignment="Center"/></StackPanel></Button>
                        <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Settings"><StackPanel Orientation="Horizontal"><TextBlock Text="⚙" FontSize="21" Width="34"/><TextBlock Text="تنظیمات" VerticalAlignment="Center"/></StackPanel></Button>
                    </StackPanel>
                </ScrollViewer>
                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="10" Margin="4,10,4,8">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" Background="{DynamicResource AccentSoft}"><Grid><TextBlock Text="م" Foreground="{DynamicResource Accent}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding Settings.ManagerImagePath}" Stretch="UniformToFill"/></Grid></Border>
                        <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding Settings.ManagerName}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/><TextBlock Text="مدیر سیستم" Style="{StaticResource SmallMuted}"/></StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Row="3" CornerRadius="12" Background="{DynamicResource SoftSurface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" Padding="10" Margin="4"><TextBlock Text="ساخته شده توسط  © MNRAHIMI . Ltd" HorizontalAlignment="Center" TextAlignment="Center" Foreground="{DynamicResource Muted}" FontSize="11"/></Border>
            </Grid>
        </Border>
    </Grid>
</Window>
