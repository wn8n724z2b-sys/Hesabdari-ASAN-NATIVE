<Window x:Class="HesabdariAsan.Native.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:HesabdariAsan.Native.Controls"
        Title="حسابداری آسان" Height="900" Width="1500" MinHeight="720" MinWidth="1180"
        WindowStartupLocation="CenterScreen" FlowDirection="LeftToRight" Icon="Assets/app.ico"
        Background="{DynamicResource AppBackground}">
    <Grid Background="{DynamicResource AppBackground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="252"/>
        </Grid.ColumnDefinitions>

        <!-- Main surface -->
        <Grid Grid.Column="0" FlowDirection="RightToLeft" Background="{DynamicResource AppBackground}">
            <Grid.RowDefinitions>
                <RowDefinition Height="82"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- WebView v3.4 topbar port -->
            <Border Grid.Row="0" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                <Grid Margin="26,0" FlowDirection="RightToLeft">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="158"/>
                        <ColumnDefinition Width="112"/>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="112"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PageTitle}" FontSize="19" FontWeight="Bold"/>
                        <TextBlock Text="{Binding PageSubtitle}" Style="{StaticResource SmallMuted}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <Grid Grid.Column="1" Width="520" MaxWidth="520" MinWidth="300" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0">
                        <TextBox x:Name="SearchBox" Text="{Binding GlobalQuery,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" Padding="42,0,12,0" ToolTip="جستجو در کالا، مشتری، شرکت و فاکتور" Background="{DynamicResource AppBackground}"/>
                        <Viewbox Width="20" Height="20" HorizontalAlignment="Left" Margin="12,0,0,0" IsHitTestVisible="False">
                            <Path Data="{StaticResource IconSearch}" Stroke="{DynamicResource Muted}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Viewbox>
                        <Popup IsOpen="{Binding IsSearchOpen}" PlacementTarget="{Binding ElementName=SearchBox}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" Width="520">
                            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="12" Padding="6" Margin="0,6,0,0" Effect="{DynamicResource CardShadow}">
                                <ScrollViewer MaxHeight="440" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding SearchResults}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.SearchHitCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource NavButton}" Padding="10,8" Margin="0,1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Background="{DynamicResource AccentSoft}" CornerRadius="8" Padding="6,4" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Kind}" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" FontSize="10.5" FontWeight="SemiBold"/>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource SmallMuted}" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>

                    <Border Grid.Column="2" Height="44" VerticalAlignment="Center" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="12" Padding="10,5" Margin="4,0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Width="32" Height="32" CornerRadius="9" Background="{DynamicResource SuccessSoft}">
                                <Viewbox Width="17" Height="17" HorizontalAlignment="Center" VerticalAlignment="Center"><Path Data="{StaticResource IconDoor}" Stroke="{DynamicResource Success}" StrokeThickness="1.7"/></Viewbox>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="ساعات کاری" FontSize="9.5" Foreground="{DynamicResource Muted}"/>
                                <TextBlock x:Name="WorkText" FontSize="13" FontWeight="Bold" FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="3" Height="44" VerticalAlignment="Center" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="12" Padding="9,5" Margin="4,0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Viewbox Width="17" Height="17" HorizontalAlignment="Center" VerticalAlignment="Center"><Path Data="{StaticResource IconClock}" Stroke="{DynamicResource Muted}" StrokeThickness="1.8"/></Viewbox>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="ساعت سیستم" FontSize="9" Foreground="{DynamicResource Muted}"/>
                                <TextBlock x:Name="ClockText" FontSize="12.5" FontWeight="Bold" FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Button Grid.Column="4" Command="{Binding ToggleThemeCommand}" Style="{StaticResource IconButton}" ToolTip="روشن / دارک" Margin="2,0">
                        <Viewbox Width="19" Height="19"><Path Data="{StaticResource IconMoon}" Stroke="{DynamicResource MutedStrong}" Fill="Transparent" StrokeThickness="1.7"/></Viewbox>
                    </Button>

                    <Button Grid.Column="5" Command="{Binding NewSaleCommand}" Style="{StaticResource PrimaryButton}" Height="42" Margin="6,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="16" Height="16" Margin="0,0,7,0"><Path Data="{StaticResource IconPlus}" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round"/></Viewbox>
                            <TextBlock Text="فروش جدید" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <controls:AnimatedContentControl Grid.Row="1" Content="{Binding CurrentPage}"/>
        </Grid>

        <!-- Right sidebar copied from the final v3.4 shell -->
        <Border Grid.Column="1" Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0" FlowDirection="RightToLeft">
            <Grid Margin="16,18,16,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="4,0,4,14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="46" Height="46" CornerRadius="13">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#58A5FF" Offset="0"/><GradientStop Color="#1877E7" Offset="1"/></LinearGradientBrush>
                        </Border.Background>
                        <Image Source="Assets/app.ico" Stretch="Uniform" Margin="6"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="حسابداری آسان" FontSize="18" FontWeight="Bold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="مدیریت ساده، کسب‌وکار موفق" FontSize="9.5" Foreground="{DynamicResource Muted}"/>
                            <Border Background="{DynamicResource AccentSoft}" CornerRadius="5" Margin="6,0,0,0" Padding="5,1"><TextBlock Text="نسخه رایگان" FontSize="8" Foreground="{DynamicResource Accent}" FontWeight="Bold"/></Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Background="{DynamicResource SoftSurface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="12" Padding="10" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource AccentSoft}">
                            <Grid><TextBlock Text="م" Foreground="{DynamicResource Accent}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding Settings.ManagerImagePath}" Stretch="UniformToFill"/></Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Settings.ManagerName}" FontSize="11.5" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="مدیر سیستم" FontSize="9.5" Foreground="{DynamicResource Muted}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Button Command="{Binding NavigateCommand}" CommandParameter="Dashboard"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding CurrentPageKey}" Value="Dashboard"><Setter Property="Background" Value="{DynamicResource AccentSoft}"/><Setter Property="Foreground" Value="{DynamicResource Accent}"/><Setter Property="FontWeight" Value="Bold"/></DataTrigger></Style.Triggers></Style></Button.Style><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/></Grid.ColumnDefinitions><Viewbox Width="19" Height="19"><Path Data="{StaticResource IconHome}" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" Fill="Transparent"/></Viewbox><TextBlock Grid.Column="1" Text="داشبورد" VerticalAlignment="Center" FontWeight="{Binding FontWeight,RelativeSource={RelativeSource AncestorType=Button}}" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/></Grid></Button>
                        <Button Command="{Binding NavigateCommand}" CommandParameter="Sales"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding CurrentPageKey}" Value="Sales"><Setter Property="Background" Value="{DynamicResource AccentSoft}"/><Setter Property="Foreground" Value="{DynamicResource Accent}"/><Setter Property="FontWeight" Value="Bold"/></DataTrigger></Style.Triggers></Style></Button.Style><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/></Grid.ColumnDefinitions><Viewbox Width="19" Height="19"><Path Data="{StaticResource IconCart}" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" Fill="Transparent"/></Viewbox><TextBlock Grid.Column="1" Text="فروش" VerticalAlignment="Center" FontWeight="{Binding FontWeight,RelativeSource={RelativeSource AncestorType=Button}}" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/></Grid></Button>
                        <Button Command="{Binding NavigateCommand}" CommandParameter="Products"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding CurrentPageKey}" Value="Products"><Setter Property="Background" Value="{DynamicResource AccentSoft}"/><Setter Property="Foreground" Value="{DynamicResource Accent}"/><Setter Property="FontWeight" Value="Bold"/></DataTrigger></Style.Triggers></Style></Button.Style><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/></Grid.ColumnDefinitions><Viewbox Width="19" Height="19"><Path Data="{StaticResource IconBox}" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" Fill="Transparent"/></Viewbox><TextBlock Grid.Column="1" Text="کالاها" VerticalAlignment="Center" FontWeight="{Binding FontWeight,RelativeSource={RelativeSource AncestorType=Button}}" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/></Grid></Button>
                        <Button Command="{Binding NavigateCommand}" CommandParameter="Parties"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding CurrentPageKey}" Value="Parties"><Setter Property="Background" Value="{DynamicResource AccentSoft}"/><Setter Property="Foreground" Value="{DynamicResource Accent}"/><Setter Property="FontWeight" Value="Bold"/></DataTrigger></Style.Triggers></Style></Button.Style><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/></Grid.ColumnDefinitions><Viewbox Width="19" Height="19"><Path Data="{StaticResource IconUsers}" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" Fill="Transparent"/></Viewbox><TextBlock Grid.Column="1" Text="مشتریان و شرکت‌ها" VerticalAlignment="Center" FontWeight="{Binding FontWeight,RelativeSource={RelativeSource AncestorType=Button}}" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/></Grid></Button>
                        <Button Command="{Binding NavigateCommand}" CommandParameter="Categories"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding CurrentPageKey}" Value="Categories"><Setter Property="Background" Value="{DynamicResource AccentSoft}"/><Setter Property="Foreground" Value="{DynamicResource Accent}"/><Setter Property="FontWeight" Value="Bold"/></DataTrigger></Style.Triggers></Style></Button.Style><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/></Grid.ColumnDefinitions><Viewbox Width="19" Height="19"><Path Data="{StaticResource IconCategories}" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" Fill="Transparent"/></Viewbox><TextBlock Grid.Column="1" Text="دسته‌ها" VerticalAlignment="Center" FontWeight="{Binding FontWeight,RelativeSource={RelativeSource AncestorType=Button}}" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/></Grid></Button>
                        <Button Command="{Binding NavigateCommand}" CommandParameter="Expenses"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding CurrentPageKey}" Value="Expenses"><Setter Property="Background" Value="{DynamicResource AccentSoft}"/><Setter Property="Foreground" Value="{DynamicResource Accent}"/><Setter Property="FontWeight" Value="Bold"/></DataTrigger></Style.Triggers></Style></Button.Style><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/></Grid.ColumnDefinitions><Viewbox Width="19" Height="19"><Path Data="{StaticResource IconExpense}" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" Fill="Transparent"/></Viewbox><TextBlock Grid.Column="1" Text="هزینه‌ها" VerticalAlignment="Center" FontWeight="{Binding FontWeight,RelativeSource={RelativeSource AncestorType=Button}}" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/></Grid></Button>
                        <Button Command="{Binding NavigateCommand}" CommandParameter="Reports"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding CurrentPageKey}" Value="Reports"><Setter Property="Background" Value="{DynamicResource AccentSoft}"/><Setter Property="Foreground" Value="{DynamicResource Accent}"/><Setter Property="FontWeight" Value="Bold"/></DataTrigger></Style.Triggers></Style></Button.Style><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/></Grid.ColumnDefinitions><Viewbox Width="19" Height="19"><Path Data="{StaticResource IconChart}" Fill="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/></Viewbox><TextBlock Grid.Column="1" Text="گزارش‌ها" VerticalAlignment="Center" FontWeight="{Binding FontWeight,RelativeSource={RelativeSource AncestorType=Button}}" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/></Grid></Button>
                        <Button Command="{Binding NavigateCommand}" CommandParameter="Inventory"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding CurrentPageKey}" Value="Inventory"><Setter Property="Background" Value="{DynamicResource AccentSoft}"/><Setter Property="Foreground" Value="{DynamicResource Accent}"/><Setter Property="FontWeight" Value="Bold"/></DataTrigger></Style.Triggers></Style></Button.Style><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/></Grid.ColumnDefinitions><Viewbox Width="19" Height="19"><Path Data="{StaticResource IconInventory}" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" Fill="Transparent"/></Viewbox><TextBlock Grid.Column="1" Text="انبارداری" VerticalAlignment="Center" FontWeight="{Binding FontWeight,RelativeSource={RelativeSource AncestorType=Button}}" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/></Grid></Button>
                        <Button Command="{Binding NavigateCommand}" CommandParameter="Data"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding CurrentPageKey}" Value="Data"><Setter Property="Background" Value="{DynamicResource AccentSoft}"/><Setter Property="Foreground" Value="{DynamicResource Accent}"/><Setter Property="FontWeight" Value="Bold"/></DataTrigger></Style.Triggers></Style></Button.Style><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/></Grid.ColumnDefinitions><Viewbox Width="19" Height="19"><Path Data="{StaticResource IconDatabase}" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" Fill="Transparent"/></Viewbox><TextBlock Grid.Column="1" Text="داده‌ها و پشتیبانی" VerticalAlignment="Center" FontWeight="{Binding FontWeight,RelativeSource={RelativeSource AncestorType=Button}}" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/></Grid></Button>
                        <Button Command="{Binding NavigateCommand}" CommandParameter="Settings"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding CurrentPageKey}" Value="Settings"><Setter Property="Background" Value="{DynamicResource AccentSoft}"/><Setter Property="Foreground" Value="{DynamicResource Accent}"/><Setter Property="FontWeight" Value="Bold"/></DataTrigger></Style.Triggers></Style></Button.Style><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/></Grid.ColumnDefinitions><Viewbox Width="19" Height="19"><Path Data="{StaticResource IconSettings}" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" Fill="Transparent"/></Viewbox><TextBlock Grid.Column="1" Text="تنظیمات" VerticalAlignment="Center" FontWeight="{Binding FontWeight,RelativeSource={RelativeSource AncestorType=Button}}" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/></Grid></Button>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="3" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="4,13,4,0" Margin="0,10,0,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="ساخته شده توسط" FontSize="9.5" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center"/>
                        <TextBlock FontSize="10.5" Foreground="{DynamicResource Muted}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,2,0,0">
                            <Hyperlink NavigateUri="https://t.me/Naman_Rahimi" RequestNavigate="Creator_RequestNavigate" Foreground="{DynamicResource Muted}" TextDecorations="{x:Null}">© MNRAHIMI . Ltd</Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
