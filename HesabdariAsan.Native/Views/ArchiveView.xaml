<UserControl x:Class="HesabdariAsan.Native.Views.ArchiveView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Style="{StaticResource PageRoot}" FlowDirection="RightToLeft">
 <Grid Margin="26,24,26,36">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="فاکتورها" Style="{StaticResource Eyebrow}"/><TextBlock Text="آرشیو فاکتورها" Style="{StaticResource PageTitle}"/><TextBlock Text="جستجو، چاپ، ویرایش و بررسی تمام فاکتورهای ثبت‌شده" Style="{StaticResource SmallMuted}"/></StackPanel><Button Grid.Column="1" Content="بازگشت به گزارش‌ها" Command="{Binding DataContext.NavigateCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Reports" Style="{StaticResource SecondaryButton}" VerticalAlignment="Bottom"/></Grid>
  <Border Grid.Row="1" Style="{StaticResource ToolbarCard}" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="155"/><ColumnDefinition Width="155"/><ColumnDefinition Width="120"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
   <TextBox Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" ToolTip="شماره فاکتور، مشتری یا مبلغ..." Margin="0,0,6,0"/>
   <ComboBox Grid.Column="1" ItemsSource="{Binding PaymentOptions}" SelectedItem="{Binding SelectedPayment}" Style="{StaticResource Combo}" Margin="6,0"/>
   <DatePicker Grid.Column="2" SelectedDate="{Binding From}" Margin="6,0" VerticalContentAlignment="Center" ToolTip="از تاریخ"/>
   <DatePicker Grid.Column="3" SelectedDate="{Binding To}" Margin="6,0" VerticalContentAlignment="Center" ToolTip="تا تاریخ"/>
   <ComboBox Grid.Column="4" ItemsSource="{Binding PageSizes}" SelectedItem="{Binding PageSize}" Style="{StaticResource Combo}" Margin="6,0"/>
   <Button Grid.Column="5" Content="پاک‌کردن تاریخ" Command="{Binding ClearDatesCommand}" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0"/>
  </Grid></Border>
  <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
   <DataGrid ItemsSource="{Binding Items}" Style="{StaticResource GridStyle}"><DataGrid.Columns>
    <DataGridTextColumn Header="#" Binding="{Binding RowNumber}" Width="52"/>
    <DataGridTextColumn Header="فاکتور" Binding="{Binding InvoiceNo}" Width="90"/>
    <DataGridTextColumn Header="زمان" Binding="{Binding DateText}" Width="155"/>
    <DataGridTextColumn Header="مشتری" Binding="{Binding CustomerName}" Width="2*"/>
    <DataGridTextColumn Header="روش" Binding="{Binding PaymentText}" Width="90"/>
    <DataGridTextColumn Header="اقلام" Binding="{Binding ItemsText}" Width="90"/>
    <DataGridTextColumn Header="وضعیت" Binding="{Binding StatusText}" Width="90"/>
    <DataGridTextColumn Header="مبلغ" Binding="{Binding TotalText}" Width="125"/>
    <DataGridTemplateColumn Header="عملیات" Width="220"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button Content="چاپ" Command="{Binding DataContext.PrintCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}" Height="30" MinHeight="30" Padding="10,0" Margin="2"/><Button Content="ویرایش" Command="{Binding DataContext.EditCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}" Height="30" MinHeight="30" Padding="10,0" Margin="2"/><Button Content="ابطال" Command="{Binding DataContext.CancelCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource DangerGhostButton}" Height="30" MinHeight="30" Padding="10,0" Margin="2"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
   </DataGrid.Columns></DataGrid>
  </Border>
  <Grid Grid.Row="3" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Content="قبلی" Command="{Binding PreviousCommand}" Style="{StaticResource SecondaryButton}" Width="88"/><TextBlock Grid.Column="1" Text="{Binding PageText}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/><Button Grid.Column="2" Content="بعدی" Command="{Binding NextCommand}" Style="{StaticResource SecondaryButton}" Width="88"/></Grid>
 </Grid>
</UserControl>
