<UserControl x:Class="HesabdariAsan.Native.Views.ProductsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FlowDirection="RightToLeft">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="کالاها" Style="{StaticResource PageTitle}"/>
  <Grid Grid.Row="1" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" ToolTip="نام، بارکد یا دسته"/><ComboBox Grid.Column="1" ItemsSource="{Binding PageSizes}" SelectedItem="{Binding PageSize}" Style="{StaticResource Combo}" Width="90" Margin="10,0"/><Button Grid.Column="2" Content="+ کالای جدید" Command="{Binding AddCommand}" Style="{StaticResource PrimaryButton}"/></Grid>
  <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0"><DataGrid ItemsSource="{Binding Items}" Style="{StaticResource GridStyle}"><DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding RowNumber}" Width="50"/><DataGridTextColumn Header="نام کالا" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="بارکد" Binding="{Binding Barcode}" Width="150"/><DataGridTextColumn Header="دسته" Binding="{Binding Category}" Width="120"/><DataGridTextColumn Header="موجودی" Binding="{Binding StockText}" Width="90"/><DataGridTextColumn Header="خرید" Binding="{Binding PurchasePriceText}" Width="110"/><DataGridTextColumn Header="فروش" Binding="{Binding SalePriceText}" Width="110"/><DataGridTemplateColumn Header="عملیات" Width="150"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Content="ویرایش" Command="{Binding DataContext.EditCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}" Padding="10,5" Margin="2"/><Button Content="حذف" Command="{Binding DataContext.DeleteCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource DangerButton}" Padding="10,5" Margin="2"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></Border>
  <Grid Grid.Row="3" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding TotalCountText}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/><Button Grid.Column="1" Content="قبلی" Command="{Binding PreviousCommand}" Style="{StaticResource SecondaryButton}" Margin="5,0"/><TextBlock Grid.Column="2" Text="{Binding PageText}" Margin="10,0" VerticalAlignment="Center"/><Button Grid.Column="3" Content="بعدی" Command="{Binding NextCommand}" Style="{StaticResource SecondaryButton}" Margin="5,0"/></Grid>
 </Grid>
</UserControl>
