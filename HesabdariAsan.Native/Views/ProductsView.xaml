<UserControl x:Class="HesabdariAsan.Native.Views.ProductsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource PageRoot}" FlowDirection="RightToLeft">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="مدیریت کالا" Style="{StaticResource Eyebrow}"/><TextBlock Text="کالاها" Style="{StaticResource PageTitle}" Margin="0,2,0,0"/><TextBlock Text="کالا، قیمت، بارکد و موجودی در یک جدول منظم" Style="{StaticResource SmallMuted}"/></StackPanel><Button Grid.Column="1" Command="{Binding AddCommand}" Style="{StaticResource PrimaryButton}" Height="40" VerticalAlignment="Bottom"><StackPanel Orientation="Horizontal"><Viewbox Width="15" Height="15" Margin="0,0,6,0"><Path Data="{StaticResource IconPlus}" Stroke="White" StrokeThickness="2"/></Viewbox><TextBlock Text="کالای جدید" Foreground="White"/></StackPanel></Button></Grid>
  <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="175"/><ColumnDefinition Width="145"/><ColumnDefinition Width="94"/><ColumnDefinition Width="145"/></Grid.ColumnDefinitions>
    <Grid><TextBox Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" Padding="40,0,11,0" ToolTip="جستجوی نام، دسته یا بارکد..."/><Viewbox Width="18" Height="18" HorizontalAlignment="Left" Margin="12,0,0,0" IsHitTestVisible="False"><Path Data="{StaticResource IconSearch}" Stroke="{DynamicResource Muted}" StrokeThickness="1.7"/></Viewbox></Grid>
    <ComboBox Grid.Column="1" ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding SelectedCategory}" Style="{StaticResource Combo}" Margin="9,0,0,0"/><ComboBox Grid.Column="2" ItemsSource="{Binding FilterOptions}" SelectedItem="{Binding SelectedFilter}" Style="{StaticResource Combo}" Margin="9,0,0,0"/><ComboBox Grid.Column="3" ItemsSource="{Binding PageSizes}" SelectedItem="{Binding PageSize}" Style="{StaticResource Combo}" Margin="9,0,0,0"/><Button Grid.Column="4" Content="مدیریت دسته‌ها" Click="ManageCategories_Click" Style="{StaticResource SecondaryButton}" Margin="9,0,0,0"/>
   </Grid>
   <DataGrid Grid.Row="1" ItemsSource="{Binding Items}" Style="{StaticResource GridStyle}"><DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding RowNumber}" Width="50"/><DataGridTextColumn Header="کالا" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="بارکد اصلی" Binding="{Binding Barcode}" Width="155"/><DataGridTextColumn Header="دسته" Binding="{Binding Category}" Width="130"/><DataGridTextColumn Header="بهای خرید" Binding="{Binding PurchasePriceText}" Width="120"/><DataGridTextColumn Header="قیمت فروش" Binding="{Binding SalePriceText}" Width="120"/><DataGridTextColumn Header="واحد" Binding="{Binding Unit}" Width="85"/><DataGridTextColumn Header="موجودی" Binding="{Binding StockText}" Width="95"/><DataGridTemplateColumn Header="عملیات" Width="160"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button Content="ویرایش" Command="{Binding DataContext.EditCommand,RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}" Height="30" MinHeight="30" Padding="9,0" FontSize="10.5" Margin="2"/><Button Content="حذف" Command="{Binding DataContext.DeleteCommand,RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource DangerButton}" Height="30" MinHeight="30" Padding="9,0" FontSize="10.5" Margin="2"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid>
   <Grid Grid.Row="2" Margin="16,11,16,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding TotalCountText}" Style="{StaticResource SmallMuted}" VerticalAlignment="Center"/><Button Grid.Column="1" Content="قبلی" Command="{Binding PreviousCommand}" Style="{StaticResource SecondaryButton}" Height="32" MinHeight="32" Padding="10,0" Margin="4,0"/><Border Grid.Column="2" Background="{DynamicResource SoftSurface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="4,0"><TextBlock Text="{Binding PageText}" FontSize="10.5"/></Border><Button Grid.Column="3" Content="بعدی" Command="{Binding NextCommand}" Style="{StaticResource SecondaryButton}" Height="32" MinHeight="32" Padding="10,0" Margin="4,0"/></Grid>
  </Grid></Border>
 </Grid>
</UserControl>
