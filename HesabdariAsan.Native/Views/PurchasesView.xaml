<UserControl x:Class="HesabdariAsan.Native.Views.PurchasesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FlowDirection="RightToLeft">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="خرید و ورود کالا" Style="{StaticResource PageTitle}"/>
  <Grid Grid.Row="1" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBox Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" ToolTip="کالا، شرکت یا توضیح"/>
   <ComboBox Grid.Column="1" ItemsSource="{Binding PageSizes}" SelectedItem="{Binding PageSize}" Style="{StaticResource Combo}" Margin="10,0"/>
   <Button Grid.Column="2" Content="+ ثبت خرید" Command="{Binding AddCommand}" Style="{StaticResource PrimaryButton}"/>
  </Grid>
  <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0"><DataGrid ItemsSource="{Binding Items}" Style="{StaticResource GridStyle}"><DataGrid.Columns>
   <DataGridTextColumn Header="#" Binding="{Binding RowNumber}" Width="48"/>
   <DataGridTextColumn Header="کالا" Binding="{Binding ProductName}" Width="2*"/>
   <DataGridTextColumn Header="تعداد" Binding="{Binding QuantityText}" Width="85"/>
   <DataGridTextColumn Header="فی خرید" Binding="{Binding UnitCostText}" Width="115"/>
   <DataGridTextColumn Header="جمع" Binding="{Binding TotalText}" Width="120"/>
   <DataGridTextColumn Header="شرکت / تأمین‌کننده" Binding="{Binding SupplierName}" Width="170"/>
   <DataGridTextColumn Header="پرداخت" Binding="{Binding PaymentText}" Width="85"/>
   <DataGridTextColumn Header="تاریخ" Binding="{Binding DateText}" Width="150"/>
  </DataGrid.Columns></DataGrid></Border>
  <Grid Grid.Row="3" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock Text="{Binding TotalCountText}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
   <Button Grid.Column="1" Content="قبلی" Command="{Binding PreviousCommand}" Style="{StaticResource SecondaryButton}" Margin="5,0"/>
   <TextBlock Grid.Column="2" Text="{Binding PageText}" Margin="10,0" VerticalAlignment="Center"/>
   <Button Grid.Column="3" Content="بعدی" Command="{Binding NextCommand}" Style="{StaticResource SecondaryButton}" Margin="5,0"/>
  </Grid>
 </Grid>
</UserControl>
