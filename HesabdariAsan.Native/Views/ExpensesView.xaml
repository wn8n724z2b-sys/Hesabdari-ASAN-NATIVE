<UserControl x:Class="HesabdariAsan.Native.Views.ExpensesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FlowDirection="RightToLeft">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="هزینه‌ها" Style="{StaticResource PageTitle}"/>
  <UniformGrid Grid.Row="1" Columns="3" Margin="-5,0,-5,14"><Border Style="{StaticResource StatCard}"><StackPanel><TextBlock Text="هزینه امروز" Style="{StaticResource StatLabel}"/><TextBlock Text="{Binding TodayText}" Style="{StaticResource StatValue}"/></StackPanel></Border><Border Style="{StaticResource StatCard}"><StackPanel><TextBlock Text="هزینه ماه جاری" Style="{StaticResource StatLabel}"/><TextBlock Text="{Binding MonthText}" Style="{StaticResource StatValue}"/></StackPanel></Border><Border Style="{StaticResource StatCard}"><StackPanel><TextBlock Text="بیشترین هزینه" Style="{StaticResource StatLabel}"/><TextBlock Text="{Binding MaxText}" Style="{StaticResource StatValue}"/><TextBlock Text="{Binding MaxTitle}" Style="{StaticResource SmallMuted}"/></StackPanel></Border></UniformGrid>
  <Grid Grid.Row="2" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="90"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" ToolTip="جستجوی هزینه"/><ComboBox Grid.Column="1" ItemsSource="{Binding PageSizes}" SelectedItem="{Binding PageSize}" Style="{StaticResource Combo}" Margin="10,0"/><Button Grid.Column="2" Content="+ ثبت هزینه" Command="{Binding AddCommand}" Style="{StaticResource PrimaryButton}"/></Grid>
  <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0"><DataGrid ItemsSource="{Binding Items}" Style="{StaticResource GridStyle}"><DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding RowNumber}" Width="48"/><DataGridTextColumn Header="عنوان" Binding="{Binding Title}" Width="2*"/><DataGridTextColumn Header="دسته" Binding="{Binding Category}" Width="130"/><DataGridTextColumn Header="مبلغ" Binding="{Binding AmountText}" Width="120"/><DataGridTextColumn Header="تاریخ" Binding="{Binding DateText}" Width="150"/><DataGridTextColumn Header="یادداشت" Binding="{Binding Note}" Width="2*"/><DataGridTemplateColumn Header="عملیات" Width="145"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Content="ویرایش" Command="{Binding DataContext.EditCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}" Padding="8,5" Margin="2"/><Button Content="حذف" Command="{Binding DataContext.DeleteCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource DangerButton}" Padding="8,5" Margin="2"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></Border>
  <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,12,0,0"><Button Content="قبلی" Command="{Binding PreviousCommand}" Style="{StaticResource SecondaryButton}"/><TextBlock Text="{Binding PageText}" Margin="12,0" VerticalAlignment="Center"/><Button Content="بعدی" Command="{Binding NextCommand}" Style="{StaticResource SecondaryButton}"/></StackPanel>
 </Grid>
</UserControl>
