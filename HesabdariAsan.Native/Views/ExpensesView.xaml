<UserControl x:Class="HesabdariAsan.Native.Views.ExpensesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource PageRoot}" FlowDirection="RightToLeft">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="مالی" Style="{StaticResource Eyebrow}"/><TextBlock Text="هزینه‌ها" Style="{StaticResource PageTitle}" Margin="0,2,0,0"/><TextBlock Text="هزینه‌ها مستقیماً در سود خالص و گزارش‌ها استفاده می‌شوند." Style="{StaticResource SmallMuted}"/></StackPanel>
   <Button Grid.Column="1" Command="{Binding AddCommand}" Style="{StaticResource PrimaryButton}" Padding="16,0"><StackPanel Orientation="Horizontal"><Viewbox Width="16" Height="16" Margin="0,0,7,0"><Path Data="{StaticResource IconPlus}" Stroke="White" StrokeThickness="2"/></Viewbox><TextBlock Text="ثبت هزینه" Foreground="White" FontWeight="Bold"/></StackPanel></Button>
  </Grid>
  <UniformGrid Grid.Row="1" Columns="4" Margin="-5,0,-5,12">
   <Border Style="{StaticResource StatCard}" Margin="5"><StackPanel><TextBlock Text="هزینه امروز" Style="{StaticResource StatLabel}"/><TextBlock Text="{Binding TodayText}" Style="{StaticResource StatValue}" Foreground="{DynamicResource Danger}"/><TextBlock Text="جمع هزینه امروز" Style="{StaticResource SmallMuted}"/></StackPanel></Border>
   <Border Style="{StaticResource StatCard}" Margin="5"><StackPanel><TextBlock Text="هزینه ماه جاری" Style="{StaticResource StatLabel}"/><TextBlock Text="{Binding MonthText}" Style="{StaticResource StatValue}"/><TextBlock Text="جمع ماه" Style="{StaticResource SmallMuted}"/></StackPanel></Border>
   <Border Style="{StaticResource StatCard}" Margin="5"><StackPanel><TextBlock Text="بیشترین هزینه" Style="{StaticResource StatLabel}"/><TextBlock Text="{Binding MaxText}" Style="{StaticResource StatValue}" Foreground="{DynamicResource Warning}"/><TextBlock Text="{Binding MaxTitle}" Style="{StaticResource SmallMuted}" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
   <Border Style="{StaticResource StatCard}" Margin="5"><StackPanel><TextBlock Text="تعداد رکوردها" Style="{StaticResource StatLabel}"/><TextBlock Text="{Binding TotalCountText}" Style="{StaticResource StatValue}"/><TextBlock Text="در بازه انتخاب‌شده" Style="{StaticResource SmallMuted}"/></StackPanel></Border>
  </UniformGrid>
  <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="160"/><ColumnDefinition Width="94"/></Grid.ColumnDefinitions>
     <Grid><TextBox Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" Padding="40,0,11,0" ToolTip="نوع هزینه یا یادداشت..."/><Viewbox Width="18" Height="18" HorizontalAlignment="Left" Margin="12,0,0,0" IsHitTestVisible="False"><Path Data="{StaticResource IconSearch}" Stroke="{DynamicResource Muted}" StrokeThickness="1.7"/></Viewbox></Grid>
     <ComboBox Grid.Column="1" ItemsSource="{Binding PeriodOptions}" SelectedItem="{Binding SelectedPeriod}" Style="{StaticResource Combo}" Margin="9,0,0,0"/>
     <ComboBox Grid.Column="2" ItemsSource="{Binding PageSizes}" SelectedItem="{Binding PageSize}" Style="{StaticResource Combo}" Margin="9,0,0,0"/>
    </Grid>
    <DataGrid Grid.Row="1" ItemsSource="{Binding Items}" Style="{StaticResource GridStyle}"><DataGrid.Columns>
     <DataGridTextColumn Header="#" Binding="{Binding RowNumber}" Width="48"/><DataGridTextColumn Header="تاریخ" Binding="{Binding DateText}" Width="150"/><DataGridTextColumn Header="نوع هزینه" Binding="{Binding Category}" Width="150"/><DataGridTextColumn Header="عنوان" Binding="{Binding Title}" Width="1.4*"/><DataGridTextColumn Header="یادداشت" Binding="{Binding Note}" Width="2*"/><DataGridTextColumn Header="مبلغ" Binding="{Binding AmountText}" Width="120"/>
     <DataGridTemplateColumn Header="عملیات" Width="170"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Content="ویرایش" Command="{Binding DataContext.EditCommand,RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}" Height="31" MinHeight="31" Padding="9,0" Margin="2"/><Button Content="حذف" Command="{Binding DataContext.DeleteCommand,RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource DangerButton}" Height="31" MinHeight="31" Padding="9,0" Margin="2"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    </DataGrid.Columns></DataGrid>
    <Grid Grid.Row="2" Margin="16,11,16,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding TotalCountText}" Style="{StaticResource SmallMuted}" VerticalAlignment="Center"/><Button Grid.Column="1" Content="قبلی" Command="{Binding PreviousCommand}" Style="{StaticResource SecondaryButton}" Height="32" MinHeight="32" Padding="10,0" Margin="4,0"/><Border Grid.Column="2" Background="{DynamicResource SoftSurface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="4,0"><TextBlock Text="{Binding PageText}" FontSize="10.5"/></Border><Button Grid.Column="3" Content="بعدی" Command="{Binding NextCommand}" Style="{StaticResource SecondaryButton}" Height="32" MinHeight="32" Padding="10,0" Margin="4,0"/></Grid>
   </Grid>
  </Border>
 </Grid>
</UserControl>
