<UserControl x:Class="HesabdariAsan.Native.Views.AuditView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FlowDirection="RightToLeft">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="ثبت رویدادها" Style="{StaticResource PageTitle}"/>
  <Grid Grid.Row="1" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
   <TextBox Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" ToolTip="عملیات، نوع، شناسه یا شماره فاکتور"/>
   <ComboBox Grid.Column="1" ItemsSource="{Binding PageSizes}" SelectedItem="{Binding PageSize}" Style="{StaticResource Combo}" Margin="10,0,0,0"/>
  </Grid>
  <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0"><DataGrid ItemsSource="{Binding Items}" Style="{StaticResource GridStyle}"><DataGrid.Columns>
   <DataGridTextColumn Header="#" Binding="{Binding RowNumber}" Width="48"/>
   <DataGridTextColumn Header="زمان" Binding="{Binding DateText}" Width="165"/>
   <DataGridTextColumn Header="عملیات" Binding="{Binding Action}" Width="175"/>
   <DataGridTextColumn Header="نوع" Binding="{Binding EntityType}" Width="120"/>
   <DataGridTextColumn Header="شناسه" Binding="{Binding EntityId}" Width="90"/>
   <DataGridTextColumn Header="فاکتور" Binding="{Binding InvoiceText}" Width="80"/>
   <DataGridTextColumn Header="کاربر" Binding="{Binding Actor}" Width="90"/>
   <DataGridTextColumn Header="جزئیات" Binding="{Binding PayloadJson}" Width="3*"/>
  </DataGrid.Columns></DataGrid></Border>
  <Grid Grid.Row="3" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock Text="{Binding TotalCountText}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
   <Button Grid.Column="1" Content="قبلی" Command="{Binding PreviousCommand}" Style="{StaticResource SecondaryButton}" Margin="5,0"/>
   <TextBlock Grid.Column="2" Text="{Binding PageText}" Margin="10,0" VerticalAlignment="Center"/>
   <Button Grid.Column="3" Content="بعدی" Command="{Binding NextCommand}" Style="{StaticResource SecondaryButton}" Margin="5,0"/>
  </Grid>
 </Grid>
</UserControl>
