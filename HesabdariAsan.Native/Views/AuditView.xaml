<UserControl x:Class="HesabdariAsan.Native.Views.AuditView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource PageRoot}" FlowDirection="RightToLeft">
 <Grid Margin="26,24,26,36"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,18"><TextBlock Text="امنیت و تاریخچه" Style="{StaticResource Eyebrow}"/><TextBlock Text="ثبت رویدادها" Style="{StaticResource PageTitle}" Margin="0,2,0,0"/><TextBlock Text="تاریخچه تغییرات حساس، فاکتورها و عملیات سیستم" Style="{StaticResource SmallMuted}"/></StackPanel>
  <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="16,14,16,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="105"/></Grid.ColumnDefinitions><Grid><TextBox Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" Padding="40,0,11,0" ToolTip="عملیات، نوع، شناسه یا شماره فاکتور"/><Viewbox Width="18" Height="18" HorizontalAlignment="Left" Margin="12,0,0,0" IsHitTestVisible="False"><Path Data="{StaticResource IconSearch}" Stroke="{DynamicResource Muted}" StrokeThickness="1.7"/></Viewbox></Grid><ComboBox Grid.Column="1" ItemsSource="{Binding PageSizes}" SelectedItem="{Binding PageSize}" Style="{StaticResource Combo}" Margin="10,0,0,0"/></Grid>
   <DataGrid Grid.Row="1" ItemsSource="{Binding Items}" Style="{StaticResource GridStyle}"><DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding RowNumber}" Width="46"/><DataGridTextColumn Header="زمان" Binding="{Binding DateText}" Width="155"/><DataGridTextColumn Header="عملیات" Binding="{Binding Action}" Width="165"/><DataGridTextColumn Header="نوع" Binding="{Binding EntityType}" Width="115"/><DataGridTextColumn Header="شناسه" Binding="{Binding EntityId}" Width="90"/><DataGridTextColumn Header="فاکتور" Binding="{Binding InvoiceText}" Width="85"/><DataGridTextColumn Header="کاربر" Binding="{Binding Actor}" Width="95"/><DataGridTextColumn Header="جزئیات" Binding="{Binding PayloadJson}" Width="3*"/></DataGrid.Columns></DataGrid>
   <Grid Grid.Row="2" Margin="16,11,16,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding TotalCountText}" Style="{StaticResource SmallMuted}" VerticalAlignment="Center"/><Button Grid.Column="1" Content="قبلی" Command="{Binding PreviousCommand}" Style="{StaticResource SecondaryButton}" Height="32" MinHeight="32" Padding="10,0" Margin="4,0"/><Border Grid.Column="2" Background="{DynamicResource SoftSurface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="4,0"><TextBlock Text="{Binding PageText}" FontSize="10.5"/></Border><Button Grid.Column="3" Content="بعدی" Command="{Binding NextCommand}" Style="{StaticResource SecondaryButton}" Height="32" MinHeight="32" Padding="10,0" Margin="4,0"/></Grid>
  </Grid></Border>
 </Grid>
</UserControl>
