<UserControl x:Class="HesabdariAsan.Native.Views.CategoriesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource PageRoot}" FlowDirection="RightToLeft">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="ساختار کالا" Style="{StaticResource Eyebrow}"/><TextBlock Text="دسته‌ها" Style="{StaticResource PageTitle}" Margin="0,2,0,0"/><TextBlock Text="ویرایش، مرتب‌سازی و مدیریت دسته‌بندی کالاها" Style="{StaticResource SmallMuted}"/></StackPanel><Button Grid.Column="1" Content="+ دسته جدید" Command="{Binding AddCommand}" Style="{StaticResource PrimaryButton}"/></Grid>
  <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid Margin="14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="94"/></Grid.ColumnDefinitions><Grid><TextBox Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" Padding="40,0,11,0" ToolTip="جستجوی دسته..."/><Viewbox Width="18" Height="18" HorizontalAlignment="Left" Margin="12,0,0,0" IsHitTestVisible="False"><Path Data="{StaticResource IconSearch}" Stroke="{DynamicResource Muted}" StrokeThickness="1.7"/></Viewbox></Grid><ComboBox Grid.Column="1" ItemsSource="{Binding PageSizes}" SelectedItem="{Binding PageSize}" Style="{StaticResource Combo}" Margin="9,0,0,0"/></Grid>
   <DataGrid Grid.Row="1" ItemsSource="{Binding Items}" Style="{StaticResource GridStyle}"><DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding RowNumber}" Width="55"/><DataGridTextColumn Header="نام دسته" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="تعداد کالا" Binding="{Binding CountText}" Width="140"/><DataGridTextColumn Header="ترتیب" Binding="{Binding SortOrder}" Width="100"/><DataGridTemplateColumn Header="عملیات" Width="310"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Content="ویرایش" Command="{Binding DataContext.EditCommand,RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}" Height="31" MinHeight="31" Padding="9,0" Margin="2"/><Button Content="بالا" Command="{Binding DataContext.UpCommand,RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}" Height="31" MinHeight="31" Padding="9,0" Margin="2"/><Button Content="پایین" Command="{Binding DataContext.DownCommand,RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}" Height="31" MinHeight="31" Padding="9,0" Margin="2"/><Button Content="حذف" Command="{Binding DataContext.DeleteCommand,RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource DangerButton}" Height="31" MinHeight="31" Padding="9,0" Margin="2"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid>
   <Grid Grid.Row="2" Margin="16,11,16,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding TotalCountText}" Style="{StaticResource SmallMuted}"/><Button Grid.Column="1" Content="قبلی" Command="{Binding PreviousCommand}" Style="{StaticResource SecondaryButton}" Height="32" MinHeight="32" Margin="4,0"/><TextBlock Grid.Column="2" Text="{Binding PageText}" Margin="12,0" VerticalAlignment="Center"/><Button Grid.Column="3" Content="بعدی" Command="{Binding NextCommand}" Style="{StaticResource SecondaryButton}" Height="32" MinHeight="32" Margin="4,0"/></Grid>
  </Grid></Border>
 </Grid>
</UserControl>
