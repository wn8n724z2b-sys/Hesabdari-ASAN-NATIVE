<UserControl x:Class="HesabdariAsan.Native.Views.PartiesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource PageRoot}" FlowDirection="RightToLeft">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="26,24,26,36">
  <StackPanel Margin="0,0,0,18"><TextBlock Text="اشخاص" Style="{StaticResource Eyebrow}"/><TextBlock Text="مشتریان و شرکت‌ها" Style="{StaticResource PageTitle}" Margin="0,2,0,0"/><TextBlock Text="قرض‌ها، دریافت‌ها و تأمین‌کنندگان" Style="{StaticResource SmallMuted}"/></StackPanel>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
   <!-- Customers -->
   <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0" Margin="0,0,7,0" MinHeight="560"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="18,17,18,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="مشتریان" Style="{StaticResource SectionTitle}"/><TextBlock Text="جستجو و مدیریت دفتر قرضه" Style="{StaticResource SmallMuted}"/></StackPanel><Button Grid.Column="1" Content="+ مشتری" Command="{Binding AddCustomerCommand}" Style="{StaticResource PrimaryButton}" Height="34" MinHeight="34" Padding="12,0" FontSize="11"/></Grid>
    <Grid Grid.Row="1" Margin="16,0,16,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="82"/></Grid.ColumnDefinitions><Grid><TextBox Text="{Binding CustomerSearch,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" Padding="39,0,10,0" ToolTip="نام یا شماره مشتری"/><Viewbox Width="17" Height="17" HorizontalAlignment="Left" Margin="12,0,0,0" IsHitTestVisible="False"><Path Data="{StaticResource IconSearch}" Stroke="{DynamicResource Muted}" StrokeThickness="1.7"/></Viewbox></Grid><ComboBox Grid.Column="1" ItemsSource="{Binding PageSizes}" SelectedItem="{Binding CustomerPageSize}" Style="{StaticResource Combo}" Margin="8,0,0,0"/></Grid>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="560"><ItemsControl ItemsSource="{Binding CustomerItems}" Margin="12,0"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource SoftSurface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="11" Padding="12" Margin="3,3"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Name}" FontWeight="Bold"/><TextBlock Text="  ●" Foreground="{DynamicResource Accent}" FontSize="8" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsPinned}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel><TextBlock Text="{Binding Phone}" Style="{StaticResource SmallMuted}"/></StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Left"><TextBlock Text="قرض" Style="{StaticResource SmallMuted}" HorizontalAlignment="Left"/><TextBlock Text="{Binding DebtText}" FontWeight="Bold" Foreground="{DynamicResource Danger}" FlowDirection="LeftToRight"/></StackPanel></Grid><StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,9,0,0" HorizontalAlignment="Left"><Button Content="پرداخت" Command="{Binding DataContext.PaymentCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource PrimaryButton}" Height="29" MinHeight="29" Padding="9,0" FontSize="9.5" Margin="0,0,5,0"/><Button Content="پین" Command="{Binding DataContext.PinCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}" Height="29" MinHeight="29" Padding="9,0" FontSize="9.5" Margin="0,0,5,0"/><Button Content="ویرایش" Command="{Binding DataContext.EditCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}" Height="29" MinHeight="29" Padding="9,0" FontSize="9.5" Margin="0,0,5,0"/><Button Content="حذف" Command="{Binding DataContext.DeleteCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource DangerButton}" Height="29" MinHeight="29" Padding="9,0" FontSize="9.5"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
    <Grid Grid.Row="3" Margin="16,12,16,15"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding CustomerTotalText}" Style="{StaticResource SmallMuted}" VerticalAlignment="Center"/><Button Grid.Column="1" Content="قبلی" Command="{Binding CustomerPreviousCommand}" Style="{StaticResource SecondaryButton}" Height="30" MinHeight="30" Padding="8,0" FontSize="10" Margin="3,0"/><TextBlock Grid.Column="2" Text="{Binding CustomerPageText}" VerticalAlignment="Center" FontSize="10" Margin="7,0"/><Button Grid.Column="3" Content="بعدی" Command="{Binding CustomerNextCommand}" Style="{StaticResource SecondaryButton}" Height="30" MinHeight="30" Padding="8,0" FontSize="10" Margin="3,0"/></Grid>
   </Grid></Border>
   <!-- Suppliers -->
   <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0" Margin="7,0,0,0" MinHeight="560"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="18,17,18,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="شرکت‌ها / تأمین‌کنندگان" Style="{StaticResource SectionTitle}"/><TextBlock Text="مانده قرض و پرداخت‌ها" Style="{StaticResource SmallMuted}"/></StackPanel><Button Grid.Column="1" Content="+ شرکت" Command="{Binding AddSupplierCommand}" Style="{StaticResource PrimaryButton}" Height="34" MinHeight="34" Padding="12,0" FontSize="11"/></Grid>
    <Grid Grid.Row="1" Margin="16,0,16,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="82"/></Grid.ColumnDefinitions><Grid><TextBox Text="{Binding SupplierSearch,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" Padding="39,0,10,0" ToolTip="جستجوی شرکت"/><Viewbox Width="17" Height="17" HorizontalAlignment="Left" Margin="12,0,0,0" IsHitTestVisible="False"><Path Data="{StaticResource IconSearch}" Stroke="{DynamicResource Muted}" StrokeThickness="1.7"/></Viewbox></Grid><ComboBox Grid.Column="1" ItemsSource="{Binding PageSizes}" SelectedItem="{Binding SupplierPageSize}" Style="{StaticResource Combo}" Margin="8,0,0,0"/></Grid>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="560"><ItemsControl ItemsSource="{Binding SupplierItems}" Margin="12,0"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource SoftSurface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="11" Padding="12" Margin="3,3"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Name}" FontWeight="Bold"/><TextBlock Text="  ●" Foreground="{DynamicResource Accent}" FontSize="8" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsPinned}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel><TextBlock Text="{Binding Phone}" Style="{StaticResource SmallMuted}"/></StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Left"><TextBlock Text="قرض" Style="{StaticResource SmallMuted}" HorizontalAlignment="Left"/><TextBlock Text="{Binding DebtText}" FontWeight="Bold" Foreground="{DynamicResource Warning}" FlowDirection="LeftToRight"/></StackPanel></Grid><StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,9,0,0" HorizontalAlignment="Left"><Button Content="پرداخت" Command="{Binding DataContext.PaymentCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource PrimaryButton}" Height="29" MinHeight="29" Padding="9,0" FontSize="9.5" Margin="0,0,5,0"/><Button Content="پین" Command="{Binding DataContext.PinCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}" Height="29" MinHeight="29" Padding="9,0" FontSize="9.5" Margin="0,0,5,0"/><Button Content="ویرایش" Command="{Binding DataContext.EditCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}" Height="29" MinHeight="29" Padding="9,0" FontSize="9.5" Margin="0,0,5,0"/><Button Content="حذف" Command="{Binding DataContext.DeleteCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource DangerButton}" Height="29" MinHeight="29" Padding="9,0" FontSize="9.5"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
    <Grid Grid.Row="3" Margin="16,12,16,15"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding SupplierTotalText}" Style="{StaticResource SmallMuted}" VerticalAlignment="Center"/><Button Grid.Column="1" Content="قبلی" Command="{Binding SupplierPreviousCommand}" Style="{StaticResource SecondaryButton}" Height="30" MinHeight="30" Padding="8,0" FontSize="10" Margin="3,0"/><TextBlock Grid.Column="2" Text="{Binding SupplierPageText}" VerticalAlignment="Center" FontSize="10" Margin="7,0"/><Button Grid.Column="3" Content="بعدی" Command="{Binding SupplierNextCommand}" Style="{StaticResource SecondaryButton}" Height="30" MinHeight="30" Padding="8,0" FontSize="10" Margin="3,0"/></Grid>
   </Grid></Border>
  </Grid>
 </StackPanel></ScrollViewer>
</UserControl>
