<UserControl x:Class="HesabdariAsan.Native.Views.PartiesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FlowDirection="RightToLeft">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="مشتریان و شرکت‌ها" Style="{StaticResource PageTitle}"/>
  <Grid Grid.Row="1" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/><ColumnDefinition Width="90"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" ToolTip="نام، تلفن یا آدرس"/><ComboBox Grid.Column="1" ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding SelectedType}" Style="{StaticResource Combo}" Margin="10,0"/><ComboBox Grid.Column="2" ItemsSource="{Binding PageSizes}" SelectedItem="{Binding PageSize}" Style="{StaticResource Combo}"/><Button Grid.Column="3" Content="+ مورد جدید" Command="{Binding AddCommand}" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"/></Grid>
  <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0"><DataGrid ItemsSource="{Binding Items}" Style="{StaticResource GridStyle}"><DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding RowNumber}" Width="46"/><DataGridTextColumn Header="پین" Binding="{Binding PinText}" Width="50"/><DataGridTextColumn Header="نوع" Binding="{Binding TypeText}" Width="130"/><DataGridTextColumn Header="نام" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="تلفن" Binding="{Binding Phone}" Width="135"/><DataGridTextColumn Header="قرض" Binding="{Binding DebtText}" Width="110"/><DataGridTemplateColumn Header="عملیات" Width="300"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Content="پین" Command="{Binding DataContext.PinCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}" Padding="9,5" Margin="2"/><Button Content="تسویه قرض" Command="{Binding DataContext.PaymentCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource PrimaryButton}" Padding="9,5" Margin="2"/><Button Content="ویرایش" Command="{Binding DataContext.EditCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}" Padding="9,5" Margin="2"/><Button Content="حذف" Command="{Binding DataContext.DeleteCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource DangerButton}" Padding="9,5" Margin="2"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></Border>
  <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,12,0,0"><Button Content="قبلی" Command="{Binding PreviousCommand}" Style="{StaticResource SecondaryButton}"/><TextBlock Text="{Binding PageText}" Margin="12,0" VerticalAlignment="Center"/><Button Content="بعدی" Command="{Binding NextCommand}" Style="{StaticResource SecondaryButton}"/></StackPanel>
 </Grid>
</UserControl>
