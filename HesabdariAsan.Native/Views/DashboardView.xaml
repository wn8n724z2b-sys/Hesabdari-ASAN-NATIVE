<UserControl x:Class="HesabdariAsan.Native.Views.DashboardView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:HesabdariAsan.Native.Controls" FlowDirection="RightToLeft">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
  <TextBlock Text="داشبورد" Style="{StaticResource PageTitle}"/>
  <UniformGrid Columns="5" Margin="-5,0,-5,16">
   <Border Style="{StaticResource StatCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="46"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="فروش امروز" Style="{StaticResource StatLabel}"/><TextBlock Text="{Binding Metrics.TodaySalesText}" Style="{StaticResource StatValue}"/></StackPanel><Border Grid.Column="1" Width="42" Height="42" CornerRadius="12" Background="{DynamicResource AccentSoft}" VerticalAlignment="Center"><TextBlock Text="↗" FontSize="22" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></Border>
   <Border Style="{StaticResource StatCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="46"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="سود خالص" Style="{StaticResource StatLabel}"/><TextBlock Text="{Binding Metrics.TodayNetProfitText}" Style="{StaticResource StatValue}"/></StackPanel><Border Grid.Column="1" Width="42" Height="42" CornerRadius="12" Background="#1222C55E" VerticalAlignment="Center"><TextBlock Text="+" FontSize="23" Foreground="{DynamicResource Success}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></Border>
   <Border Style="{StaticResource StatCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="46"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="هزینه امروز" Style="{StaticResource StatLabel}"/><TextBlock Text="{Binding Metrics.TodayExpensesText}" Style="{StaticResource StatValue}"/></StackPanel><Border Grid.Column="1" Width="42" Height="42" CornerRadius="12" Background="#12EF4444" VerticalAlignment="Center"><TextBlock Text="−" FontSize="23" Foreground="{DynamicResource Danger}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></Border>
   <Border Style="{StaticResource StatCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="46"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="قرض مشتریان" Style="{StaticResource StatLabel}"/><TextBlock Text="{Binding Metrics.CustomerDebtText}" Style="{StaticResource StatValue}"/></StackPanel><Border Grid.Column="1" Width="42" Height="42" CornerRadius="12" Background="#12A855F7" VerticalAlignment="Center"><TextBlock Text="◎" FontSize="21" Foreground="MediumPurple" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></Border>
   <Border Style="{StaticResource StatCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="46"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="ارزش موجودی" Style="{StaticResource StatLabel}"/><TextBlock Text="{Binding Metrics.InventoryValueText}" Style="{StaticResource StatValue}"/></StackPanel><Border Grid.Column="1" Width="42" Height="42" CornerRadius="12" Background="#1206B6D4" VerticalAlignment="Center"><TextBlock Text="▦" FontSize="21" Foreground="DeepSkyBlue" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></Border>
  </UniformGrid>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.7*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Text="عملکرد مالی" FontSize="18" FontWeight="Bold"/><TextBlock Text="14 روز اخیر" Style="{StaticResource SmallMuted}" Margin="0,4,0,8"/><controls:FinanceChart Data="{Binding Trend}" Height="280"/></StackPanel></Border>
   <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0"><StackPanel><TextBlock Text="آخرین فاکتورها" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/><DataGrid ItemsSource="{Binding RecentInvoices}" Style="{StaticResource GridStyle}" MaxHeight="300"><DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding RowNumber}" Width="42"/><DataGridTextColumn Header="فاکتور" Binding="{Binding InvoiceNo}" Width="70"/><DataGridTextColumn Header="مشتری" Binding="{Binding CustomerName}" Width="*"/><DataGridTextColumn Header="وضعیت" Binding="{Binding StatusText}" Width="65"/><DataGridTextColumn Header="مبلغ" Binding="{Binding TotalText}" Width="100"/></DataGrid.Columns></DataGrid></StackPanel></Border>
  </Grid>
 </StackPanel></ScrollViewer>
</UserControl>
