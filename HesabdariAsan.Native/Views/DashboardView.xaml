<UserControl x:Class="HesabdariAsan.Native.Views.DashboardView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:HesabdariAsan.Native.Controls"
 Style="{StaticResource PageRoot}" FlowDirection="RightToLeft">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="26,24,26,36">
   <Grid Margin="0,0,0,18">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel>
     <TextBlock Text="امروز" Style="{StaticResource Eyebrow}"/>
     <TextBlock Text="نمای کلی کسب‌وکار" Style="{StaticResource PageTitle}" Margin="0,2,0,0"/>
     <TextBlock Text="مهم‌ترین اعداد روز را بدون شلوغی ببینید." Style="{StaticResource SmallMuted}"/>
    </StackPanel>
    <Button Grid.Column="1" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" Height="38" VerticalAlignment="Bottom">
     <StackPanel Orientation="Horizontal"><Viewbox Width="15" Height="15" Margin="0,0,7,0"><Path Data="{StaticResource IconRefresh}" Stroke="{DynamicResource MutedStrong}" StrokeThickness="1.7" Fill="Transparent"/></Viewbox><TextBlock Text="تازه‌سازی"/></StackPanel>
    </Button>
   </Grid>

   <UniformGrid Columns="5" Margin="-6,0,-6,10">
    <Border Style="{StaticResource StatCard}"><StackPanel><Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource AccentSoft}" HorizontalAlignment="Right" Margin="0,0,0,11"><Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"><Path Data="M4,16 L10,10 L14,14 L20,7 M15,7 L20,7 L20,12" Stroke="{DynamicResource Accent}" StrokeThickness="1.8" Fill="Transparent"/></Viewbox></Border><TextBlock Text="فروش امروز" Style="{StaticResource StatLabel}"/><TextBlock Text="{Binding Metrics.TodaySalesText}" Style="{StaticResource StatValue}"/><TextBlock Text="{Binding Metrics.TodaySalesCountText}" Style="{StaticResource SmallMuted}"/></StackPanel></Border>
    <Border Style="{StaticResource StatCard}"><StackPanel><Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource SuccessSoft}" HorizontalAlignment="Right" Margin="0,0,0,11"><Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"><Path Data="M4,16 C7,13 8,9 11,11 C14,13 15,8 20,6" Stroke="{DynamicResource Success}" StrokeThickness="1.8" Fill="Transparent"/></Viewbox></Border><TextBlock Text="سود خالص امروز" Style="{StaticResource StatLabel}"/><TextBlock Text="{Binding Metrics.TodayNetProfitText}" Style="{StaticResource StatValue}"/><TextBlock Text="پس از هزینه‌های امروز" Style="{StaticResource SmallMuted}"/></StackPanel></Border>
    <Border Style="{StaticResource StatCard}"><StackPanel><Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource DangerSoft}" HorizontalAlignment="Right" Margin="0,0,0,11"><Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"><Path Data="{StaticResource IconExpense}" Stroke="{DynamicResource Danger}" StrokeThickness="1.7" Fill="Transparent"/></Viewbox></Border><TextBlock Text="هزینه امروز" Style="{StaticResource StatLabel}"/><TextBlock Text="{Binding Metrics.TodayExpensesText}" Style="{StaticResource StatValue}"/><TextBlock Text="هزینه‌های ثبت‌شده" Style="{StaticResource SmallMuted}"/></StackPanel></Border>
    <Border Style="{StaticResource StatCard}"><StackPanel><Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource PurpleSoft}" HorizontalAlignment="Right" Margin="0,0,0,11"><Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"><Path Data="M19,8 A7,7 0 1 0 18,17 M19,8 L19,3 M19,8 L14,8" Stroke="{DynamicResource Purple}" StrokeThickness="1.8" Fill="Transparent"/></Viewbox></Border><TextBlock Text="قرض مشتریان" Style="{StaticResource StatLabel}"/><TextBlock Text="{Binding Metrics.CustomerDebtText}" Style="{StaticResource StatValue}"/><TextBlock Text="مانده نسیه مشتریان" Style="{StaticResource SmallMuted}"/></StackPanel></Border>
    <Border Style="{StaticResource StatCard}"><StackPanel><Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource WarningSoft}" HorizontalAlignment="Right" Margin="0,0,0,11"><Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"><Path Data="{StaticResource IconBox}" Stroke="{DynamicResource Warning}" StrokeThickness="1.7" Fill="Transparent"/></Viewbox></Border><TextBlock Text="ارزش موجودی" Style="{StaticResource StatLabel}"/><TextBlock Text="{Binding Metrics.InventoryValueText}" Style="{StaticResource StatValue}"/><TextBlock Text="بر اساس قیمت خرید" Style="{StaticResource SmallMuted}"/></StackPanel></Border>
   </UniformGrid>

   <Grid Margin="0,0,0,14">
    <Grid.ColumnDefinitions><ColumnDefinition Width="1.9*"/><ColumnDefinition Width="0.95*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="18" Margin="0,0,7,0" MinHeight="390">
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="روند فروش و سود" Style="{StaticResource SectionTitle}"/><TextBlock Text="عملکرد روزانه بر اساس داده‌های واقعی" Style="{StaticResource SmallMuted}" Margin="0,4,0,0"/></StackPanel><Border Grid.Column="1" Background="{DynamicResource SoftSurface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="9" Padding="9,5"><TextBlock Text="14 روز اخیر" FontSize="10.5" Foreground="{DynamicResource Muted}"/></Border></Grid>
      <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,2"><StackPanel Orientation="Horizontal" Margin="0,0,14,0"><Ellipse Width="8" Height="8" Fill="{DynamicResource Accent}" Margin="0,0,5,0"/><TextBlock Text="فروش" FontSize="10.5" Foreground="{DynamicResource Muted}"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,14,0"><Ellipse Width="8" Height="8" Fill="{DynamicResource Danger}" Margin="0,0,5,0"/><TextBlock Text="هزینه" FontSize="10.5" Foreground="{DynamicResource Muted}"/></StackPanel><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{DynamicResource Success}" Margin="0,0,5,0"/><TextBlock Text="سود خالص" FontSize="10.5" Foreground="{DynamicResource Muted}"/></StackPanel></StackPanel>
      <controls:FinanceChart Grid.Row="2" Data="{Binding Trend}" ShowAllSeries="False" Height="285" Margin="0,4,0,0"/>
     </Grid>
    </Border>

    <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16" Margin="7,0,0,0" MinHeight="390">
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="فروش‌های اخیر" Style="{StaticResource SectionTitle}"/><TextBlock Text="آخرین فاکتورهای ثبت‌شده" Style="{StaticResource SmallMuted}" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="1" Content="مشاهده همه" Command="{Binding DataContext.NavigateCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Reports" Style="{StaticResource SecondaryButton}" Padding="9,0" Height="32" FontSize="10.5"/></Grid>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding RecentInvoices}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="5,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource SuccessSoft}"><Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"><Path Data="{StaticResource IconCart}" Stroke="{DynamicResource Success}" StrokeThickness="1.6" Fill="Transparent"/></Viewbox></Border><StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding CustomerName}" FontSize="11.5" FontWeight="SemiBold"/><TextBlock Text="{Binding DateText}" FontSize="9.5" Foreground="{DynamicResource Muted}" Margin="0,2,0,0"/></StackPanel><StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left"><TextBlock Text="{Binding TotalText}" FontSize="11.5" FontWeight="Bold" FlowDirection="LeftToRight"/><TextBlock Text="{Binding PaymentText}" FontSize="9" Foreground="{DynamicResource Muted}" HorizontalAlignment="Left"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
     </Grid>
    </Border>
   </Grid>

   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="1.8*"/><ColumnDefinition Width="0.75*"/><ColumnDefinition Width="0.75*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16" Margin="0,0,7,0" MinHeight="150"><StackPanel><TextBlock Text="دسترسی سریع" Style="{StaticResource SectionTitle}"/><TextBlock Text="عملیات پرکاربرد سیستم" Style="{StaticResource SmallMuted}" Margin="0,3,0,10"/><UniformGrid Columns="4">
     <Button Command="{Binding DataContext.NavigateCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Sales" Style="{StaticResource SecondaryButton}" Margin="3" Padding="10" MinHeight="74"><StackPanel Orientation="Horizontal"><Border Width="38" Height="38" CornerRadius="11" Background="{DynamicResource AccentSoft}" Margin="0,0,8,0"><Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"><Path Data="{StaticResource IconPlus}" Stroke="{DynamicResource Accent}" StrokeThickness="2"/></Viewbox></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="ثبت فاکتور" FontSize="11.5" FontWeight="Bold"/><TextBlock Text="فروش جدید" FontSize="9.5" Foreground="{DynamicResource Muted}"/></StackPanel></StackPanel></Button>
     <Button Command="{Binding AddProductCommand}" Style="{StaticResource SecondaryButton}" Margin="3" Padding="10" MinHeight="74"><StackPanel Orientation="Horizontal"><Border Width="38" Height="38" CornerRadius="11" Background="{DynamicResource SuccessSoft}" Margin="0,0,8,0"><Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"><Path Data="{StaticResource IconBox}" Stroke="{DynamicResource Success}" StrokeThickness="1.7"/></Viewbox></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="کالای جدید" FontSize="11.5" FontWeight="Bold"/><TextBlock Text="ثبت کالا" FontSize="9.5" Foreground="{DynamicResource Muted}"/></StackPanel></StackPanel></Button>
     <Button Command="{Binding AddCustomerCommand}" Style="{StaticResource SecondaryButton}" Margin="3" Padding="10" MinHeight="74"><StackPanel Orientation="Horizontal"><Border Width="38" Height="38" CornerRadius="11" Background="{DynamicResource WarningSoft}" Margin="0,0,8,0"><Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"><Path Data="{StaticResource IconUsers}" Stroke="{DynamicResource Warning}" StrokeThickness="1.6"/></Viewbox></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="مشتری جدید" FontSize="11.5" FontWeight="Bold"/><TextBlock Text="ثبت مشتری" FontSize="9.5" Foreground="{DynamicResource Muted}"/></StackPanel></StackPanel></Button>
     <Button Command="{Binding AddExpenseCommand}" Style="{StaticResource SecondaryButton}" Margin="3" Padding="10" MinHeight="74"><StackPanel Orientation="Horizontal"><Border Width="38" Height="38" CornerRadius="11" Background="{DynamicResource DangerSoft}" Margin="0,0,8,0"><Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"><Path Data="{StaticResource IconExpense}" Stroke="{DynamicResource Danger}" StrokeThickness="1.7"/></Viewbox></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="ثبت هزینه" FontSize="11.5" FontWeight="Bold"/><TextBlock Text="هزینه جدید" FontSize="9.5" Foreground="{DynamicResource Muted}"/></StackPanel></StackPanel></Button>
    </UniformGrid></StackPanel></Border>
    <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16" Margin="7,0" MinHeight="150"><StackPanel><TextBlock Text="وضعیت موجودی" Style="{StaticResource SectionTitle}"/><TextBlock Text="خلاصه انبار" Style="{StaticResource SmallMuted}" Margin="0,3,0,4"/><TextBlock Text="{Binding Metrics.LowStockCountText}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource Accent}"/><TextBlock Text="کالای کم‌موجود" Style="{StaticResource SmallMuted}"/><Button Content="مشاهده انبار" Command="{Binding DataContext.NavigateCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Inventory" Style="{StaticResource SecondaryButton}" Height="32" Margin="0,10,0,0" HorizontalAlignment="Right" FontSize="10"/></StackPanel></Border>
    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16" Margin="7,0,0,0" MinHeight="150"><StackPanel><TextBlock Text="مشتریان" Style="{StaticResource SectionTitle}"/><TextBlock Text="خلاصه مشتریان" Style="{StaticResource SmallMuted}" Margin="0,3,0,4"/><TextBlock Text="{Binding Metrics.CustomerCountText}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource Accent}"/><TextBlock Text="مشتری ثبت‌شده" Style="{StaticResource SmallMuted}"/><Button Content="مشاهده مشتریان" Command="{Binding DataContext.NavigateCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Parties" Style="{StaticResource SecondaryButton}" Height="32" Margin="0,10,0,0" HorizontalAlignment="Right" FontSize="10"/></StackPanel></Border>
   </Grid>
  </StackPanel>
 </ScrollViewer>
</UserControl>
