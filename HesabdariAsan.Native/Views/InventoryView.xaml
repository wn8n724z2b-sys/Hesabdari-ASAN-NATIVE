<UserControl x:Class="HesabdariAsan.Native.Views.InventoryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FlowDirection="RightToLeft">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="انبار" Style="{StaticResource PageTitle}"/>
  <UniformGrid Grid.Row="1" Columns="4" Margin="-5,0,-5,14"><Border Style="{StaticResource StatCard}"><StackPanel><TextBlock Text="تعداد کالا" Style="{StaticResource StatLabel}"/><TextBlock Text="{Binding TotalProducts}" Style="{StaticResource StatValue}"/></StackPanel></Border><Border Style="{StaticResource StatCard}"><StackPanel><TextBlock Text="کم موجود" Style="{StaticResource StatLabel}"/><TextBlock Text="{Binding LowStock}" Style="{StaticResource StatValue}"/></StackPanel></Border><Border Style="{StaticResource StatCard}"><StackPanel><TextBlock Text="تمام شده" Style="{StaticResource StatLabel}"/><TextBlock Text="{Binding OutOfStock}" Style="{StaticResource StatValue}"/></StackPanel></Border><Border Style="{StaticResource StatCard}"><StackPanel><TextBlock Text="ارزش موجودی" Style="{StaticResource StatLabel}"/><TextBlock Text="{Binding InventoryValue}" Style="{StaticResource StatValue}"/></StackPanel></Border></UniformGrid>
  <Grid Grid.Row="2" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><TextBox Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" ToolTip="کالا، بارکد یا دسته"/><ComboBox Grid.Column="1" ItemsSource="{Binding PageSizes}" SelectedItem="{Binding PageSize}" Style="{StaticResource Combo}" Margin="10,0,0,0"/></Grid>
  <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0"><DataGrid ItemsSource="{Binding Items}" Style="{StaticResource GridStyle}"><DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding RowNumber}" Width="48"/><DataGridTextColumn Header="کالا" Binding="{Binding ProductName}" Width="2*"/><DataGridTextColumn Header="بارکد" Binding="{Binding Barcode}" Width="150"/><DataGridTextColumn Header="دسته" Binding="{Binding Category}" Width="130"/><DataGridTextColumn Header="موجودی" Binding="{Binding StockText}" Width="95"/><DataGridTextColumn Header="وضعیت" Binding="{Binding Status}" Width="90"/><DataGridTextColumn Header="ارزش" Binding="{Binding ValueText}" Width="130"/></DataGrid.Columns></DataGrid></Border>
  <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,12,0,0"><Button Content="قبلی" Command="{Binding PreviousCommand}" Style="{StaticResource SecondaryButton}"/><TextBlock Text="{Binding PageText}" Margin="12,0" VerticalAlignment="Center"/><Button Content="بعدی" Command="{Binding NextCommand}" Style="{StaticResource SecondaryButton}"/></StackPanel>
 </Grid>
</UserControl>
