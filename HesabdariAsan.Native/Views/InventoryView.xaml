<UserControl x:Class="HesabdariAsan.Native.Views.InventoryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource PageRoot}" FlowDirection="RightToLeft">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="انبارداری" Style="{StaticResource Eyebrow}"/><TextBlock Text="انبار" Style="{StaticResource PageTitle}" Margin="0,2,0,0"/><TextBlock Text="موجودی، ارزش، کاردکس و خریدهای اخیر" Style="{StaticResource SmallMuted}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="خرید و ورود کالا" Command="{Binding AddPurchaseCommand}" Style="{StaticResource SecondaryButton}" Padding="16,0" Margin="0,0,8,0"/><Button Content="اصلاح موجودی" Command="{Binding AdjustInventoryCommand}" Style="{StaticResource PrimaryButton}" Padding="16,0"/></StackPanel></Grid>
  <UniformGrid Grid.Row="1" Columns="4" Margin="-5,0,-5,12">
   <Border Style="{StaticResource StatCard}" Margin="5"><StackPanel><TextBlock Text="تعداد کالا" Style="{StaticResource StatLabel}"/><TextBlock Text="{Binding TotalProducts}" Style="{StaticResource StatValue}"/><TextBlock Text="کالاهای فعال" Style="{StaticResource SmallMuted}"/></StackPanel></Border>
   <Border Style="{StaticResource StatCard}" Margin="5"><StackPanel><TextBlock Text="تعداد موجودی" Style="{StaticResource StatLabel}"/><TextBlock Text="{Binding TotalUnits}" Style="{StaticResource StatValue}"/><TextBlock Text="مجموع واحدها" Style="{StaticResource SmallMuted}"/></StackPanel></Border>
   <Border Style="{StaticResource StatCard}" Margin="5"><StackPanel><TextBlock Text="ارزش موجودی" Style="{StaticResource StatLabel}"/><TextBlock Text="{Binding InventoryValue}" Style="{StaticResource StatValue}" Foreground="{DynamicResource Accent}"/><TextBlock Text="بر اساس بهای خرید" Style="{StaticResource SmallMuted}"/></StackPanel></Border>
   <Border Style="{StaticResource StatCard}" Margin="5"><StackPanel><TextBlock Text="هشدار موجودی" Style="{StaticResource StatLabel}"/><TextBlock Text="{Binding LowStock}" Style="{StaticResource StatValue}" Foreground="{DynamicResource Warning}"/><TextBlock Text="{Binding OutOfStockMeta}" Style="{StaticResource SmallMuted}"/></StackPanel></Border>
  </UniformGrid>
  <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" Margin="0,0,0,14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="150"/><ColumnDefinition Width="94"/></Grid.ColumnDefinitions><Grid><TextBox Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" Padding="40,0,11,0" ToolTip="جستجوی کالا یا بارکد..."/><Viewbox Width="18" Height="18" HorizontalAlignment="Left" Margin="12,0,0,0" IsHitTestVisible="False"><Path Data="{StaticResource IconSearch}" Stroke="{DynamicResource Muted}" StrokeThickness="1.7"/></Viewbox></Grid><ComboBox Grid.Column="1" ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus}" Style="{StaticResource Combo}" Margin="9,0,0,0"/><ComboBox Grid.Column="2" ItemsSource="{Binding PageSizes}" SelectedItem="{Binding PageSize}" Style="{StaticResource Combo}" Margin="9,0,0,0"/></Grid>
   <DataGrid Grid.Row="1" ItemsSource="{Binding Items}" Style="{StaticResource GridStyle}"><DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding RowNumber}" Width="48"/><DataGridTextColumn Header="کالا" Binding="{Binding ProductName}" Width="2*"/><DataGridTextColumn Header="دسته" Binding="{Binding Category}" Width="130"/><DataGridTextColumn Header="موجودی" Binding="{Binding StockText}" Width="90"/><DataGridTextColumn Header="حداقل" Binding="{Binding MinStockText}" Width="90"/><DataGridTextColumn Header="ارزش خرید" Binding="{Binding ValueText}" Width="125"/><DataGridTextColumn Header="ارزش فروش" Binding="{Binding SaleValueText}" Width="125"/><DataGridTextColumn Header="وضعیت" Binding="{Binding Status}" Width="90"/></DataGrid.Columns></DataGrid>
   <Grid Grid.Row="2" Margin="16,11,16,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding TotalCountText}" Style="{StaticResource SmallMuted}" VerticalAlignment="Center"/><Button Grid.Column="1" Content="قبلی" Command="{Binding PreviousCommand}" Style="{StaticResource SecondaryButton}" Height="32" MinHeight="32" Padding="10,0" Margin="4,0"/><Border Grid.Column="2" Background="{DynamicResource SoftSurface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="4,0"><TextBlock Text="{Binding PageText}" FontSize="10.5"/></Border><Button Grid.Column="3" Content="بعدی" Command="{Binding NextCommand}" Style="{StaticResource SecondaryButton}" Height="32" MinHeight="32" Padding="10,0" Margin="4,0"/></Grid>
  </Grid></Border>
  <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="1.55*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0" Margin="0,0,7,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid Margin="17,15,17,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="94"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="کاردکس موجودی" Style="{StaticResource SectionTitle}"/><TextBlock Text="ورود، خروج و اصلاح‌های اخیر" Style="{StaticResource SmallMuted}"/></StackPanel><ComboBox Grid.Column="1" ItemsSource="{Binding LedgerLimits}" SelectedItem="{Binding LedgerLimit}" Style="{StaticResource Combo}" Height="34" MinHeight="34"/></Grid><DataGrid Grid.Row="1" ItemsSource="{Binding Ledger}" Style="{StaticResource GridStyle}" MaxHeight="320"><DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding RowNumber}" Width="42"/><DataGridTextColumn Header="زمان" Binding="{Binding DateText}" Width="135"/><DataGridTextColumn Header="کالا" Binding="{Binding ProductName}" Width="*"/><DataGridTextColumn Header="نوع" Binding="{Binding MovementText}" Width="110"/><DataGridTextColumn Header="تغییر" Binding="{Binding QuantityText}" Width="80"/><DataGridTextColumn Header="مرجع" Binding="{Binding ReferenceType}" Width="90"/></DataGrid.Columns></DataGrid></Grid></Border>
   <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0" Margin="7,0,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Margin="17,15,17,10"><TextBlock Text="خریدهای اخیر" Style="{StaticResource SectionTitle}"/><TextBlock Text="آخرین ورود کالا به انبار" Style="{StaticResource SmallMuted}"/></StackPanel><ItemsControl Grid.Row="1" ItemsSource="{Binding RecentPurchases}" Margin="12,0,12,12"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="5,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding ProductName}" FontWeight="SemiBold"/><TextBlock Text="{Binding SupplierName}" Style="{StaticResource SmallMuted}" Margin="0,2,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{Binding TotalText}" FontWeight="Bold" FlowDirection="LeftToRight" HorizontalAlignment="Left"/><TextBlock Text="{Binding DateText}" Style="{StaticResource SmallMuted}" HorizontalAlignment="Left"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Grid></Border>
  </Grid>
 </Grid></ScrollViewer>
</UserControl>
