<UserControl x:Class="HesabdariAsan.Native.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource PageRoot}" FlowDirection="RightToLeft">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="24">
  <StackPanel Margin="0,0,0,18"><TextBlock Text="تنظیمات" Style="{StaticResource Eyebrow}"/><TextBlock Text="تنظیمات برنامه" Style="{StaticResource PageTitle}" Margin="0,2,0,0"/><TextBlock Text="ظاهر، هویت فروشگاه، چاپ و بارکدخوان" Style="{StaticResource SmallMuted}"/></StackPanel>

  <StackPanel Margin="0,0,0,12"><TextBlock Text="پروفایل" Style="{StaticResource Eyebrow}"/><TextBlock Text="مدیر سیستم" Style="{StaticResource SectionTitle}"/><TextBlock Text="نام و تصویر مدیر فقط برای نمایش داخل برنامه استفاده می‌شود." Style="{StaticResource SmallMuted}"/></StackPanel>
  <Border Style="{StaticResource Card}" Margin="0,0,0,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Border Width="82" Height="82" CornerRadius="41" Background="{DynamicResource AccentSoft}" VerticalAlignment="Top"><Grid><TextBlock Text="م" FontSize="27" FontWeight="Bold" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding ManagerImagePath}" Stretch="UniformToFill" ClipToBounds="True"/></Grid></Border>
   <StackPanel Grid.Column="1" Margin="14,0"><TextBlock Text="نام مدیر" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding ManagerName}" Style="{StaticResource Input}" MaxWidth="520" HorizontalAlignment="Stretch"/><Border Background="{DynamicResource SoftSurface}" CornerRadius="9" Padding="10" Margin="0,10,0,0"><StackPanel><TextBlock Text="مدیر سیستم" FontWeight="SemiBold"/><TextBlock Text="پروفایل نمایشی برنامه" Style="{StaticResource SmallMuted}"/></StackPanel></Border></StackPanel>
   <Button Grid.Column="2" Content="انتخاب عکس" Command="{Binding BrowseManagerImageCommand}" Style="{StaticResource SecondaryButton}" VerticalAlignment="Top"/>
  </Grid></Border>

  <StackPanel Margin="0,0,0,12"><TextBlock Text="رابط" Style="{StaticResource Eyebrow}"/><TextBlock Text="ظاهر برنامه" Style="{StaticResource SectionTitle}"/><TextBlock Text="حالت روشن یا دارک و اندازه متن." Style="{StaticResource SmallMuted}"/></StackPanel>
  <Border Style="{StaticResource Card}" Margin="0,0,0,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="حالت نمایش" FontWeight="SemiBold"/><TextBlock Text="طراحی مطابق نسخه WebView با Light / Dark واقعی" Style="{StaticResource SmallMuted}" Margin="0,3,0,0"/><ComboBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedTheme}" Style="{StaticResource Combo}" Width="180" HorizontalAlignment="Right" Margin="0,10,0,0"/></StackPanel><StackPanel Grid.Column="1"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="65"/></Grid.ColumnDefinitions><TextBlock Text="اندازه متن" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding UiScaleText}" FontWeight="Bold" HorizontalAlignment="Left"/></Grid><TextBlock Text="بزرگ‌نمایی متن‌ها بدون تغییر داده" Style="{StaticResource SmallMuted}" Margin="0,3,0,8"/><Slider Minimum="1" Maximum="2" Value="{Binding UiScale}" TickFrequency="0.05"/></StackPanel></Grid></Border>

  <StackPanel Margin="0,0,0,12"><TextBlock Text="فروشگاه" Style="{StaticResource Eyebrow}"/><TextBlock Text="هویت فروشگاه" Style="{StaticResource SectionTitle}"/><TextBlock Text="اطلاعاتی که روی رسید و گزارش‌ها استفاده می‌شود." Style="{StaticResource SmallMuted}"/></StackPanel>
  <Border Style="{StaticResource Card}" Margin="0,0,0,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <StackPanel><Border Width="112" Height="112" Background="{DynamicResource SoftSurface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="16" HorizontalAlignment="Center"><Grid><TextBlock Text="لوگو" Style="{StaticResource SmallMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding ShopLogoPath}" Stretch="UniformToFill"/></Grid></Border><Button Content="انتخاب لوگو" Command="{Binding BrowseLogoCommand}" Style="{StaticResource SecondaryButton}" Margin="0,10,0,0"/></StackPanel>
   <Grid Grid.Column="1" Margin="18,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
    <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,10"><TextBlock Text="نام فروشگاه" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding ShopName}" Style="{StaticResource Input}"/></StackPanel>
    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,10"><TextBlock Text="آدرس فروشگاه" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding ShopAddress}" Style="{StaticResource Input}"/></StackPanel>
    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,5,0"><TextBlock Text="شماره تماس" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding ShopPhone}" Style="{StaticResource Input}" FlowDirection="LeftToRight"/></StackPanel>
    <StackPanel Grid.Row="2" Grid.Column="1" Margin="5,0,0,0"><TextBlock Text="متن پایین رسید" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding ReceiptFooter}" Style="{StaticResource Input}"/></StackPanel>
   </Grid>
  </Grid></Border>

  <StackPanel Margin="0,0,0,12"><TextBlock Text="سخت‌افزار" Style="{StaticResource Eyebrow}"/><TextBlock Text="چاپ و بارکد" Style="{StaticResource SectionTitle}"/><TextBlock Text="پرینتر رسید و بارکدخوان در دو کارت هم‌اندازه." Style="{StaticResource SmallMuted}"/></StackPanel>
  <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,7,0"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="پرینتر رسید" Style="{StaticResource SectionTitle}"/><TextBlock Text="XPrinter و پرینترهای حرارتی Windows" Style="{StaticResource SmallMuted}"/></StackPanel><Border Grid.Column="1" Background="{DynamicResource SuccessSoft}" CornerRadius="999" Padding="9,4"><TextBlock Text="80mm" Foreground="{DynamicResource Success}" FontWeight="Bold"/></Border></Grid><TextBlock Text="نام پرینتر" Style="{StaticResource FieldLabel}" Margin="0,14,0,5"/><Border Background="{DynamicResource SoftSurface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="11"><TextBlock Text="{Binding PrinterText}" TextTrimming="CharacterEllipsis"/></Border><Button Content="انتخاب / شناسایی پرینتر" Command="{Binding SelectPrinterCommand}" Style="{StaticResource SecondaryButton}" Margin="0,10,0,0"/><CheckBox Content="چاپ خودکار بعد از ثبت فروش" IsChecked="{Binding PrintAfterSale}" Margin="0,14,0,0"/><Border Background="{DynamicResource SoftSurface}" CornerRadius="9" Padding="10" Margin="0,12,0,0"><TextBlock Text="چاپ Native تصویری برای حفظ متن دری/فارسی؛ بدون Auto Cut" Style="{StaticResource SmallMuted}" TextWrapping="Wrap"/></Border></StackPanel></Border>
   <Border Grid.Column="1" Style="{StaticResource Card}" Margin="7,0,0,0"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="بارکدخوان" Style="{StaticResource SectionTitle}"/><TextBlock Text="USB HID / Laser Scanner" Style="{StaticResource SmallMuted}"/></StackPanel><Border Grid.Column="1" Background="{DynamicResource WarningSoft}" CornerRadius="999" Padding="9,4"><TextBlock Text="Raw Input" Foreground="{DynamicResource Warning}" FontWeight="Bold"/></Border></Grid><CheckBox Content="فعال بودن تشخیص خودکار اسکن" IsChecked="{Binding BarcodeScannerEnabled}" Margin="0,16,0,12"/><TextBlock Text="Suffix" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding ScannerSuffixOptions}" SelectedItem="{Binding ScannerSuffix}" Style="{StaticResource Combo}" Width="160" HorizontalAlignment="Right"/><Border Background="{DynamicResource SoftSurface}" CornerRadius="9" Padding="10" Margin="0,12,0,0"><TextBlock Text="بارکدخوان‌های Keyboard Wedge نیز در فیلد جستجوی فروش قابل استفاده‌اند." Style="{StaticResource SmallMuted}" TextWrapping="Wrap"/></Border></StackPanel></Border>
  </Grid>

  <Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel><TextBlock Text="سازگاری" Style="{StaticResource SectionTitle}"/><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="Windows 10/11 64-bit" Margin="0,6"/><TextBlock Grid.Column="1" Text="فعال" Foreground="{DynamicResource Success}" FontWeight="Bold" Margin="0,6"/><TextBlock Grid.Row="1" Text="SQLite Native" Margin="0,6"/><TextBlock Grid.Row="1" Grid.Column="1" Text="WAL + Backup" Foreground="{DynamicResource Success}" FontWeight="Bold" Margin="0,6"/><TextBlock Grid.Row="2" Text="چاپ حرارتی 80mm" Margin="0,6"/><TextBlock Grid.Row="2" Grid.Column="1" Text="Windows Driver" Foreground="{DynamicResource Success}" FontWeight="Bold" Margin="0,6"/><TextBlock Grid.Row="3" Text="بارکدخوان USB HID" Margin="0,6"/><TextBlock Grid.Row="3" Grid.Column="1" Text="Raw Input" Foreground="{DynamicResource Success}" FontWeight="Bold" Margin="0,6"/></Grid></StackPanel></Border>
  <Grid Margin="0,2,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Status}" Foreground="{DynamicResource Success}" VerticalAlignment="Center"/><Button Grid.Column="1" Content="ذخیره تنظیمات" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Padding="18,0"/></Grid>
 </StackPanel></ScrollViewer>
</UserControl>
