<UserControl x:Class="HesabdariAsan.Native.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FlowDirection="RightToLeft">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
  <TextBlock Text="تنظیمات" Style="{StaticResource PageTitle}"/>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,12"><StackPanel><TextBlock Text="مدیر سیستم" FontSize="18" FontWeight="Bold" Margin="0,0,0,14"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Width="64" Height="64" CornerRadius="32" Background="{DynamicResource AccentSoft}"><Grid><TextBlock Text="م" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding ManagerImagePath}" Stretch="UniformToFill"/></Grid></Border><StackPanel Grid.Column="1"><TextBlock Text="نام مدیر" Style="{StaticResource SmallMuted}"/><TextBox Text="{Binding ManagerName}" Style="{StaticResource Input}" Margin="0,5,0,8"/><Button Content="انتخاب عکس" Command="{Binding BrowseManagerImageCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right"/></StackPanel></Grid></StackPanel></Border>
   <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,12"><StackPanel><TextBlock Text="ظاهر" FontSize="18" FontWeight="Bold" Margin="0,0,0,14"/><TextBlock Text="تم" Style="{StaticResource SmallMuted}"/><ComboBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedTheme}" Style="{StaticResource Combo}" Margin="0,5,0,14"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions><TextBlock Text="اندازه متن" Style="{StaticResource SmallMuted}"/><TextBlock Grid.Column="1" Text="{Binding UiScaleText}" HorizontalAlignment="Left" FontWeight="Bold"/></Grid><Slider Minimum="1" Maximum="2" Value="{Binding UiScale}" TickFrequency="0.1" IsSnapToTickEnabled="False" Margin="0,10,0,0"/></StackPanel></Border>
  </Grid>

  <Border Style="{StaticResource Card}" Margin="0,0,0,12"><StackPanel><TextBlock Text="هویت فروشگاه" FontSize="18" FontWeight="Bold" Margin="0,0,0,14"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Width="82" Height="82" CornerRadius="14" Background="{DynamicResource SoftSurface}" BorderBrush="{DynamicResource Border}" BorderThickness="1"><Grid><TextBlock Text="لوگو" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding ShopLogoPath}" Stretch="UniformToFill"/></Grid></Border><StackPanel Grid.Column="1" Margin="10,0"><TextBlock Text="نام فروشگاه" Style="{StaticResource SmallMuted}"/><TextBox Text="{Binding ShopName}" Style="{StaticResource Input}" Margin="0,5,0,10"/><TextBlock Text="شماره تماس" Style="{StaticResource SmallMuted}"/><TextBox Text="{Binding ShopPhone}" Style="{StaticResource Input}" FlowDirection="LeftToRight" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="2" Margin="10,0"><TextBlock Text="آدرس" Style="{StaticResource SmallMuted}"/><TextBox Text="{Binding ShopAddress}" Style="{StaticResource Input}" Margin="0,5,0,10"/><Button Content="انتخاب لوگو" Command="{Binding BrowseLogoCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right"/></StackPanel></Grid></StackPanel></Border>

  <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Text="چاپ فاکتور" FontSize="18" FontWeight="Bold"/><TextBlock Text="چاپ Native از طریق درایور Windows؛ بدون گزینه برش خودکار." Style="{StaticResource SmallMuted}" Margin="0,5,0,12"/><Border Background="{DynamicResource SoftSurface}" CornerRadius="10" Padding="10"><TextBlock Text="{Binding PrinterText}" TextTrimming="CharacterEllipsis"/></Border><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Button Content="انتخاب پرینتر" Command="{Binding SelectPrinterCommand}" Style="{StaticResource SecondaryButton}"/><CheckBox Content="چاپ خودکار بعد از فروش" IsChecked="{Binding PrintAfterSale}" VerticalAlignment="Center" Margin="16,0,0,0"/></StackPanel></StackPanel></Border>
   <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0"><StackPanel><TextBlock Text="بارکدخوان" FontSize="18" FontWeight="Bold"/><TextBlock Text="Raw Input برای بارکدخوان USB/HID وقتی پنجره برنامه فعال است." Style="{StaticResource SmallMuted}" Margin="0,5,0,12"/><CheckBox Content="فعال بودن تشخیص خودکار اسکن" IsChecked="{Binding BarcodeScannerEnabled}"/><TextBlock Text="اگر Raw Input دستگاه در دسترس نباشد، اسکن در فیلد جستجوی فروش همچنان مثل کیبورد کار می‌کند." TextWrapping="Wrap" Style="{StaticResource SmallMuted}" Margin="0,10,0,0"/></StackPanel></Border>
  </Grid>

  <Border Style="{StaticResource Card}" Margin="0,0,0,12"><StackPanel><TextBlock Text="داده‌ها و پشتیبان‌گیری" FontSize="18" FontWeight="Bold"/><Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0"><TextBlock Text="Backup خودکار در روز" Style="{StaticResource SmallMuted}"/><ComboBox ItemsSource="{Binding BackupOptions}" SelectedItem="{Binding AutoBackupPerDay}" Style="{StaticResource Combo}" Margin="0,5,0,0"/></StackPanel><Button Grid.Column="1" Content="ساخت Backup" Command="{Binding BackupCommand}" Style="{StaticResource PrimaryButton}" Margin="10,18,0,0"/><Button Grid.Column="2" Content="بازیابی Backup" Command="{Binding RestoreCommand}" Style="{StaticResource SecondaryButton}" Margin="8,18,0,0"/><Button Grid.Column="3" Content="پوشه Backup" Command="{Binding OpenBackupFolderCommand}" Style="{StaticResource SecondaryButton}" Margin="8,18,0,0"/></Grid><Separator Margin="0,14"/><StackPanel Orientation="Horizontal"><Button Content="انتقال اطلاعات از v3.4" Command="{Binding MigrateV34Command}" Style="{StaticResource SecondaryButton}"/><Button Content="بررسی سلامت دیتابیس" Command="{Binding CheckDatabaseCommand}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"/><TextBlock Text="قبل از Restore یا انتقال، Backup ایمنی خودکار ساخته می‌شود." Style="{StaticResource SmallMuted}" VerticalAlignment="Center" Margin="14,0,0,0"/></StackPanel></StackPanel></Border>

  <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"><TextBlock Text="{Binding Status}" Foreground="{DynamicResource Success}" VerticalAlignment="Center" Margin="0,0,12,0"/><Button Content="ذخیره تنظیمات" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}"/></StackPanel>
 </StackPanel></ScrollViewer>
</UserControl>
