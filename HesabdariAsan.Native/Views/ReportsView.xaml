<UserControl x:Class="HesabdariAsan.Native.Views.ReportsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:HesabdariAsan.Native.Controls" FlowDirection="RightToLeft">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="300"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="گزارش‌ها" Style="{StaticResource PageTitle}"/>
  <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel><TextBlock Text="روند مالی 30 روز اخیر" FontSize="18" FontWeight="Bold"/><StackPanel Orientation="Horizontal" Margin="0,5,0,0"><TextBlock Text="فروش" Foreground="DodgerBlue" Margin="0,0,12,0"/><TextBlock Text="هزینه" Foreground="OrangeRed" Margin="0,0,12,0"/><TextBlock Text="قرض" Foreground="MediumPurple" Margin="0,0,12,0"/><TextBlock Text="پرداخت" Foreground="DeepSkyBlue" Margin="0,0,12,0"/><TextBlock Text="سود خالص" Foreground="MediumSeaGreen"/></StackPanel><controls:FinanceChart Data="{Binding Trend}" Height="230"/></StackPanel></Border>
  <Grid Grid.Row="2" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><TextBox Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" ToolTip="شماره فاکتور یا مشتری"/><ComboBox Grid.Column="1" ItemsSource="{Binding PageSizes}" SelectedItem="{Binding PageSize}" Style="{StaticResource Combo}" Margin="10,0,0,0"/></Grid>
  <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0"><DataGrid ItemsSource="{Binding Items}" Style="{StaticResource GridStyle}"><DataGrid.Columns>
   <DataGridTextColumn Header="#" Binding="{Binding RowNumber}" Width="44"/><DataGridTextColumn Header="فاکتور" Binding="{Binding InvoiceNo}" Width="75"/><DataGridTextColumn Header="مشتری" Binding="{Binding CustomerName}" Width="2*"/><DataGridTextColumn Header="نوع" Binding="{Binding PaymentText}" Width="75"/><DataGridTextColumn Header="وضعیت" Binding="{Binding StatusText}" Width="75"/><DataGridTextColumn Header="مبلغ" Binding="{Binding TotalText}" Width="110"/><DataGridTextColumn Header="تاریخ" Binding="{Binding DateText}" Width="145"/>
   <DataGridTemplateColumn Header="عملیات" Width="230"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Content="چاپ" Command="{Binding DataContext.PrintCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}" Padding="8,4" Margin="2"/><Button Content="ویرایش" Command="{Binding DataContext.EditCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}" Padding="8,4" Margin="2"/><Button Content="ابطال" Command="{Binding DataContext.CancelCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource DangerButton}" Padding="8,4" Margin="2"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
  </DataGrid.Columns></DataGrid></Border>
  <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,12,0,0"><Button Content="قبلی" Command="{Binding PreviousCommand}" Style="{StaticResource SecondaryButton}"/><TextBlock Text="{Binding PageText}" Margin="12,0" VerticalAlignment="Center"/><Button Content="بعدی" Command="{Binding NextCommand}" Style="{StaticResource SecondaryButton}"/></StackPanel>
 </Grid>
</UserControl>
