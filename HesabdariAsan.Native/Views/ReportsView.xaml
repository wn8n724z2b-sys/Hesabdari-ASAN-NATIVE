<UserControl x:Class="HesabdariAsan.Native.Views.ReportsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:HesabdariAsan.Native.Controls" Style="{StaticResource PageRoot}" FlowDirection="RightToLeft">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="تحلیل مالی" Style="{StaticResource Eyebrow}"/><TextBlock Text="گزارش‌ها" Style="{StaticResource PageTitle}" Margin="0,2,0,0"/><TextBlock Text="گزارش ساده، قابل فهم و قابل فیلتر" Style="{StaticResource SmallMuted}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="بازه گزارش" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding PeriodOptions}" SelectedItem="{Binding SelectedPeriod}" Style="{StaticResource Combo}"/></StackPanel></Grid>
  <Border Grid.Row="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,12"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsCustomPeriod}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="180"/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><DatePicker SelectedDate="{Binding CustomFrom}"/><DatePicker Grid.Column="1" SelectedDate="{Binding CustomTo}" Margin="8,0"/><Button Grid.Column="2" Content="اعمال بازه" Command="{Binding ApplyCustomCommand}" Style="{StaticResource SecondaryButton}"/></Grid></Border>
  <UniformGrid Grid.Row="2" Columns="5" Margin="-5,0,-5,12"><Border Style="{StaticResource StatCard}" Margin="5"><StackPanel><TextBlock Text="فروش" Style="{StaticResource StatLabel}"/><TextBlock Text="{Binding SalesText}" Style="{StaticResource StatValue}" Foreground="{DynamicResource Accent}"/><TextBlock Text="{Binding SalesMeta}" Style="{StaticResource SmallMuted}"/></StackPanel></Border><Border Style="{StaticResource StatCard}" Margin="5"><StackPanel><TextBlock Text="هزینه" Style="{StaticResource StatLabel}"/><TextBlock Text="{Binding ExpensesText}" Style="{StaticResource StatValue}" Foreground="{DynamicResource Danger}"/><TextBlock Text="هزینه‌های بازه" Style="{StaticResource SmallMuted}"/></StackPanel></Border><Border Style="{StaticResource StatCard}" Margin="5"><StackPanel><TextBlock Text="قرض" Style="{StaticResource StatLabel}"/><TextBlock Text="{Binding DebtText}" Style="{StaticResource StatValue}" Foreground="{DynamicResource Purple}"/><TextBlock Text="فروش نسیه بازه" Style="{StaticResource SmallMuted}"/></StackPanel></Border><Border Style="{StaticResource StatCard}" Margin="5"><StackPanel><TextBlock Text="پرداخت" Style="{StaticResource StatLabel}"/><TextBlock Text="{Binding PaymentsText}" Style="{StaticResource StatValue}" Foreground="{DynamicResource Cyan}"/><TextBlock Text="دریافت قرض مشتریان" Style="{StaticResource SmallMuted}"/></StackPanel></Border><Border Style="{StaticResource StatCard}" Margin="5"><StackPanel><TextBlock Text="سود خالص" Style="{StaticResource StatLabel}"/><TextBlock Text="{Binding ProfitText}" Style="{StaticResource StatValue}" Foreground="{DynamicResource Success}"/><TextBlock Text="سود فروش منهای هزینه" Style="{StaticResource SmallMuted}"/></StackPanel></Border></UniformGrid>
  <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0" Margin="0,0,0,14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="280"/></Grid.RowDefinitions><Grid Margin="18,15"><StackPanel><TextBlock Text="نمودار مالی" Style="{StaticResource SectionTitle}"/><TextBlock Text="فروش، هزینه، قرض، پرداخت و سود خالص" Style="{StaticResource SmallMuted}" Margin="0,2,0,0"/></StackPanel></Grid><controls:FinanceChart Grid.Row="1" Items="{Binding Trend}" ShowAllSeries="True" Margin="12,0,12,14"/></Grid></Border>
  <Border Grid.Row="4" Style="{StaticResource Card}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid Margin="14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="145"/><ColumnDefinition Width="94"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid><TextBox Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" Padding="40,0,11,0" ToolTip="شماره فاکتور، مشتری یا مبلغ..."/><Viewbox Width="18" Height="18" HorizontalAlignment="Left" Margin="12,0,0,0"><Path Data="{StaticResource IconSearch}" Stroke="{DynamicResource Muted}" StrokeThickness="1.7"/></Viewbox></Grid><ComboBox Grid.Column="1" ItemsSource="{Binding PaymentOptions}" SelectedItem="{Binding SelectedPayment}" Style="{StaticResource Combo}" Margin="9,0,0,0"/><ComboBox Grid.Column="2" ItemsSource="{Binding PageSizes}" SelectedItem="{Binding PageSize}" Style="{StaticResource Combo}" Margin="9,0,0,0"/><Button Grid.Column="3" Content="چاپ آخرین رسید" Command="{Binding PrintLastCommand}" Style="{StaticResource SecondaryButton}" Margin="9,0,0,0"/></Grid>
   <DataGrid Grid.Row="1" ItemsSource="{Binding Items}" Style="{StaticResource GridStyle}" MaxHeight="480"><DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding RowNumber}" Width="48"/><DataGridTextColumn Header="فاکتور" Binding="{Binding InvoiceNo}" Width="80"/><DataGridTextColumn Header="زمان" Binding="{Binding DateText}" Width="145"/><DataGridTextColumn Header="مشتری" Binding="{Binding CustomerName}" Width="*"/><DataGridTextColumn Header="روش" Binding="{Binding PaymentText}" Width="90"/><DataGridTextColumn Header="وضعیت" Binding="{Binding StatusText}" Width="90"/><DataGridTextColumn Header="مبلغ" Binding="{Binding TotalText}" Width="120"/><DataGridTemplateColumn Header="عملیات" Width="240"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Content="چاپ" Command="{Binding DataContext.PrintCommand,RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}" Height="30" MinHeight="30" Padding="8,0" Margin="2"/><Button Content="ویرایش" Command="{Binding DataContext.EditCommand,RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}" Height="30" MinHeight="30" Padding="8,0" Margin="2"/><Button Content="ابطال" Command="{Binding DataContext.CancelCommand,RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource DangerButton}" Height="30" MinHeight="30" Padding="8,0" Margin="2"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid>
   <Grid Grid.Row="2" Margin="16,11,16,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding TotalCountText}" Style="{StaticResource SmallMuted}"/><Button Grid.Column="1" Content="قبلی" Command="{Binding PreviousCommand}" Style="{StaticResource SecondaryButton}" Height="32" MinHeight="32" Margin="4,0"/><TextBlock Grid.Column="2" Text="{Binding PageText}" Margin="12,0" VerticalAlignment="Center"/><Button Grid.Column="3" Content="بعدی" Command="{Binding NextCommand}" Style="{StaticResource SecondaryButton}" Height="32" MinHeight="32" Margin="4,0"/></Grid>
  </Grid></Border>
 </Grid></ScrollViewer>
</UserControl>
