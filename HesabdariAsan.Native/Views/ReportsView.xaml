<UserControl x:Class="HesabdariAsan.Native.Views.ReportsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:HesabdariAsan.Native.Controls"
 Style="{StaticResource PageRoot}" FlowDirection="RightToLeft">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <Grid Margin="26,24,26,36">
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
   </Grid.RowDefinitions>

   <Grid Margin="0,0,0,18">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="تحلیل مالی" Style="{StaticResource Eyebrow}"/><TextBlock Text="گزارش‌ها" Style="{StaticResource PageTitle}" Margin="0,2,0,0"/><TextBlock Text="گزارش ساده، قابل فهم و قابل فیلتر" Style="{StaticResource SmallMuted}"/></StackPanel>
    <StackPanel Grid.Column="1"><TextBlock Text="بازه گزارش" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding PeriodOptions}" SelectedItem="{Binding SelectedPeriod}" Style="{StaticResource Combo}"/></StackPanel>
   </Grid>

   <Border Grid.Row="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,12">
    <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsCustomPeriod}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="185"/><ColumnDefinition Width="185"/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><DatePicker SelectedDate="{Binding CustomFrom}"/><DatePicker Grid.Column="1" SelectedDate="{Binding CustomTo}" Margin="8,0"/><Button Grid.Column="2" Content="اعمال بازه" Command="{Binding ApplyCustomCommand}" Style="{StaticResource SecondaryButton}"/></Grid>
   </Border>

   <UniformGrid Grid.Row="2" Columns="5" Margin="-5,0,-5,14">
    <Border Style="{StaticResource ReportKpiCard}" Margin="5"><StackPanel><TextBlock Text="فروش" Style="{StaticResource StatLabel}"/><TextBlock Text="{Binding SalesText}" Style="{StaticResource StatValue}" Foreground="{DynamicResource Accent}"/><TextBlock Text="{Binding SalesMeta}" Style="{StaticResource SmallMuted}"/></StackPanel></Border>
    <Border Style="{StaticResource ReportKpiCard}" Margin="5"><StackPanel><TextBlock Text="هزینه" Style="{StaticResource StatLabel}"/><TextBlock Text="{Binding ExpensesText}" Style="{StaticResource StatValue}" Foreground="{DynamicResource Danger}"/><TextBlock Text="هزینه‌های بازه" Style="{StaticResource SmallMuted}"/></StackPanel></Border>
    <Border Style="{StaticResource ReportKpiCard}" Margin="5"><StackPanel><TextBlock Text="قرض" Style="{StaticResource StatLabel}"/><TextBlock Text="{Binding DebtText}" Style="{StaticResource StatValue}" Foreground="{DynamicResource Purple}"/><TextBlock Text="فروش نسیه بازه" Style="{StaticResource SmallMuted}"/></StackPanel></Border>
    <Border Style="{StaticResource ReportKpiCard}" Margin="5"><StackPanel><TextBlock Text="پرداخت" Style="{StaticResource StatLabel}"/><TextBlock Text="{Binding PaymentsText}" Style="{StaticResource StatValue}" Foreground="{DynamicResource Cyan}"/><TextBlock Text="دریافت قرض مشتریان" Style="{StaticResource SmallMuted}"/></StackPanel></Border>
    <Border Style="{StaticResource ReportKpiCard}" Margin="5"><StackPanel><TextBlock Text="سود خالص" Style="{StaticResource StatLabel}"/><TextBlock Text="{Binding ProfitText}" Style="{StaticResource StatValue}" Foreground="{DynamicResource Success}"/><TextBlock Text="سود فروش منهای هزینه" Style="{StaticResource SmallMuted}"/></StackPanel></Border>
   </UniformGrid>

   <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0" Margin="0,0,0,14">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="300"/></Grid.RowDefinitions>
     <Grid Margin="18,15"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="نمودار مالی" Style="{StaticResource SectionTitle}"/><TextBlock Text="سری‌های مورد نیاز را روشن یا خاموش کنید." Style="{StaticResource SmallMuted}" Margin="0,2,0,0"/></StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
       <ToggleButton Content="فروش" IsChecked="{Binding ShowSales}" Style="{StaticResource SeriesToggle}"/>
       <ToggleButton Content="هزینه" IsChecked="{Binding ShowExpenses}" Style="{StaticResource SeriesToggle}"/>
       <ToggleButton Content="قرض" IsChecked="{Binding ShowDebt}" Style="{StaticResource SeriesToggle}"/>
       <ToggleButton Content="پرداخت" IsChecked="{Binding ShowPayments}" Style="{StaticResource SeriesToggle}"/>
       <ToggleButton Content="سود خالص" IsChecked="{Binding ShowProfit}" Style="{StaticResource SeriesToggle}"/>
      </StackPanel>
     </Grid>
     <controls:FinanceChart Grid.Row="1" Data="{Binding Trend}" ShowAllSeries="True" ShowSales="{Binding ShowSales}" ShowExpenses="{Binding ShowExpenses}" ShowDebt="{Binding ShowDebt}" ShowPayments="{Binding ShowPayments}" ShowProfit="{Binding ShowProfit}" Margin="12,0,12,14"/>
    </Grid>
   </Border>

   <Grid Grid.Row="4" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="18" Margin="0,0,7,0">
     <StackPanel>
      <TextBlock Text="خلاصه مالی" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding PeriodLabel,StringFormat=جزئیات بازه: {0}}" Style="{StaticResource SmallMuted}" Margin="0,3,0,9"/>
      <UniformGrid Columns="2">
       <StackPanel Margin="0,0,12,0">
        <Border Style="{StaticResource ReportSummaryRow}"><Grid><TextBlock Text="فروش کل"/><TextBlock Text="{Binding SummarySales}" HorizontalAlignment="Left" FontWeight="Bold" FlowDirection="LeftToRight"/></Grid></Border>
        <Border Style="{StaticResource ReportSummaryRow}"><Grid><TextBlock Text="ورودی نقدی"/><TextBlock Text="{Binding SummaryCashIn}" HorizontalAlignment="Left" FontWeight="SemiBold" FlowDirection="LeftToRight"/></Grid></Border>
        <Border Style="{StaticResource ReportSummaryRow}"><Grid><TextBlock Text="خروجی نقدی"/><TextBlock Text="{Binding SummaryCashOut}" HorizontalAlignment="Left" FontWeight="SemiBold" FlowDirection="LeftToRight"/></Grid></Border>
        <Border Style="{StaticResource ReportSummaryRow}"><Grid><TextBlock Text="گردش خالص پول"/><TextBlock Text="{Binding SummaryNetCash}" HorizontalAlignment="Left" FontWeight="Bold" Foreground="{DynamicResource Accent}" FlowDirection="LeftToRight"/></Grid></Border>
        <Border Style="{StaticResource ReportSummaryRow}"><Grid><TextBlock Text="فروش نسیه"/><TextBlock Text="{Binding SummaryCredit}" HorizontalAlignment="Left" FlowDirection="LeftToRight"/></Grid></Border>
        <Border Style="{StaticResource ReportSummaryRow}"><Grid><TextBlock Text="دریافت قرض مشتریان"/><TextBlock Text="{Binding SummaryReceipts}" HorizontalAlignment="Left" FlowDirection="LeftToRight"/></Grid></Border>
        <Border Style="{StaticResource ReportSummaryRow}"><Grid><TextBlock Text="بهای کالای فروخته‌شده"/><TextBlock Text="{Binding SummaryCost}" HorizontalAlignment="Left" FlowDirection="LeftToRight"/></Grid></Border>
       </StackPanel>
       <StackPanel Margin="12,0,0,0">
        <Border Style="{StaticResource ReportSummaryRow}"><Grid><TextBlock Text="خرید کالا"/><TextBlock Text="{Binding SummaryPurchases}" HorizontalAlignment="Left" FlowDirection="LeftToRight"/></Grid></Border>
        <Border Style="{StaticResource ReportSummaryRow}"><Grid><TextBlock Text="خرید نقدی"/><TextBlock Text="{Binding SummaryCashPurchases}" HorizontalAlignment="Left" FlowDirection="LeftToRight"/></Grid></Border>
        <Border Style="{StaticResource ReportSummaryRow}"><Grid><TextBlock Text="هزینه‌ها"/><TextBlock Text="{Binding SummaryExpenses}" HorizontalAlignment="Left" FlowDirection="LeftToRight"/></Grid></Border>
        <Border Style="{StaticResource ReportSummaryRow}"><Grid><TextBlock Text="پرداخت قرض شرکت‌ها"/><TextBlock Text="{Binding SummarySupplierPaid}" HorizontalAlignment="Left" FlowDirection="LeftToRight"/></Grid></Border>
        <Border Style="{StaticResource ReportSummaryRow}"><Grid><TextBlock Text="تخفیف‌ها"/><TextBlock Text="{Binding SummaryDiscounts}" HorizontalAlignment="Left" FlowDirection="LeftToRight"/></Grid></Border>
        <Border Style="{StaticResource ReportSummaryRow}"><Grid><TextBlock Text="سود فروش"/><TextBlock Text="{Binding SummaryGrossProfit}" HorizontalAlignment="Left" Foreground="{DynamicResource Success}" FontWeight="SemiBold" FlowDirection="LeftToRight"/></Grid></Border>
        <Border Style="{StaticResource ReportSummaryRow}"><Grid><TextBlock Text="سود خالص" FontWeight="Bold"/><TextBlock Text="{Binding SummaryNetProfit}" HorizontalAlignment="Left" Foreground="{DynamicResource Success}" FontWeight="Bold" FlowDirection="LeftToRight"/></Grid></Border>
       </StackPanel>
      </UniformGrid>
     </StackPanel>
    </Border>

    <Border Grid.Column="1" Style="{StaticResource Card}" Padding="18" Margin="7,0,0,0">
     <StackPanel><TextBlock Text="وضعیت فعلی" Style="{StaticResource SectionTitle}"/><TextBlock Text="مانده‌های مهم همین لحظه" Style="{StaticResource SmallMuted}" Margin="0,3,0,12"/>
      <UniformGrid Columns="2">
       <Border Background="{DynamicResource AccentSoft}" CornerRadius="11" Padding="13" Margin="4"><StackPanel><TextBlock Text="قرض مشتریان" Style="{StaticResource SmallMuted}"/><TextBlock Text="{Binding CurrentCustomerDebt}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Accent}" FlowDirection="LeftToRight" Margin="0,5,0,0"/></StackPanel></Border>
       <Border Background="{DynamicResource PurpleSoft}" CornerRadius="11" Padding="13" Margin="4"><StackPanel><TextBlock Text="قرض شرکت‌ها" Style="{StaticResource SmallMuted}"/><TextBlock Text="{Binding CurrentSupplierDebt}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Purple}" FlowDirection="LeftToRight" Margin="0,5,0,0"/></StackPanel></Border>
       <Border Background="{DynamicResource WarningSoft}" CornerRadius="11" Padding="13" Margin="4"><StackPanel><TextBlock Text="ارزش موجودی" Style="{StaticResource SmallMuted}"/><TextBlock Text="{Binding CurrentInventory}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Warning}" FlowDirection="LeftToRight" Margin="0,5,0,0"/></StackPanel></Border>
       <Border Background="{DynamicResource SuccessSoft}" CornerRadius="11" Padding="13" Margin="4"><StackPanel><TextBlock Text="گردش نقدی ماه" Style="{StaticResource SmallMuted}"/><TextBlock Text="{Binding CurrentCashMonth}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Success}" FlowDirection="LeftToRight" Margin="0,5,0,0"/></StackPanel></Border>
      </UniformGrid>
     </StackPanel>
    </Border>
   </Grid>

   <Border Grid.Row="5" Style="{StaticResource Card}" Padding="0" Margin="0,0,0,14">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid Margin="18,15"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="فاکتورهای فروش" Style="{StaticResource SectionTitle}"/><TextBlock Text="برای کار روزانه فقط تعداد انتخاب‌شده نمایش داده می‌شود." Style="{StaticResource SmallMuted}" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="خروجی Excel" Command="{Binding ExportCsvCommand}" Style="{StaticResource SecondaryButton}" Height="34" MinHeight="34" Margin="3,0"/><Button Content="چاپ آخرین رسید" Command="{Binding PrintLastCommand}" Style="{StaticResource SecondaryButton}" Height="34" MinHeight="34" Margin="3,0"/><Button Content="آرشیو کامل" Command="{Binding DataContext.NavigateCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Archive" Style="{StaticResource PrimaryButton}" Height="34" MinHeight="34" Margin="3,0"/></StackPanel></Grid>
     <Grid Grid.Row="1" Margin="14,0,14,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="145"/><ColumnDefinition Width="94"/><ColumnDefinition Width="175"/></Grid.ColumnDefinitions><Grid><TextBox Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" Padding="40,0,11,0" ToolTip="شماره فاکتور، مشتری یا مبلغ..."/><Viewbox Width="18" Height="18" HorizontalAlignment="Left" Margin="12,0,0,0"><Path Data="{StaticResource IconSearch}" Stroke="{DynamicResource Muted}" StrokeThickness="1.7"/></Viewbox></Grid><ComboBox Grid.Column="1" ItemsSource="{Binding PaymentOptions}" SelectedItem="{Binding SelectedPayment}" Style="{StaticResource Combo}" Margin="9,0,0,0"/><ComboBox Grid.Column="2" ItemsSource="{Binding PageSizes}" SelectedItem="{Binding PageSize}" Style="{StaticResource Combo}" Margin="9,0,0,0"/><TextBlock Grid.Column="3" Text="{Binding InvoiceStats}" VerticalAlignment="Center" HorizontalAlignment="Left" Style="{StaticResource SmallMuted}"/></Grid>
     <DataGrid Grid.Row="2" ItemsSource="{Binding Items}" Style="{StaticResource GridStyle}" MaxHeight="480"><DataGrid.Columns><DataGridTextColumn Header="فاکتور" Binding="{Binding InvoiceNo}" Width="80"/><DataGridTextColumn Header="تاریخ/زمان" Binding="{Binding DateText}" Width="145"/><DataGridTextColumn Header="مشتری" Binding="{Binding CustomerName}" Width="*"/><DataGridTextColumn Header="روش" Binding="{Binding PaymentText}" Width="90"/><DataGridTextColumn Header="اقلام" Binding="{Binding ItemsText}" Width="75"/><DataGridTextColumn Header="وضعیت" Binding="{Binding StatusText}" Width="80"/><DataGridTextColumn Header="مبلغ" Binding="{Binding TotalText}" Width="115"/><DataGridTemplateColumn Header="عملیات" Width="235"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Content="چاپ" Command="{Binding DataContext.PrintCommand,RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}" Height="30" MinHeight="30" Padding="8,0" Margin="2"/><Button Content="ویرایش" Command="{Binding DataContext.EditCommand,RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}" Height="30" MinHeight="30" Padding="8,0" Margin="2"/><Button Content="ابطال" Command="{Binding DataContext.CancelCommand,RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource DangerButton}" Height="30" MinHeight="30" Padding="8,0" Margin="2"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid>
     <Grid Grid.Row="3" Margin="16,11,16,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding TotalCountText}" Style="{StaticResource SmallMuted}"/><Button Grid.Column="1" Content="قبلی" Command="{Binding PreviousCommand}" Style="{StaticResource SecondaryButton}" Height="32" MinHeight="32" Margin="4,0"/><TextBlock Grid.Column="2" Text="{Binding PageText}" Margin="12,0" VerticalAlignment="Center"/><Button Grid.Column="3" Content="بعدی" Command="{Binding NextCommand}" Style="{StaticResource SecondaryButton}" Height="32" MinHeight="32" Margin="4,0"/></Grid>
    </Grid>
   </Border>

   <Border Grid.Row="6" Style="{StaticResource Card}" Padding="17">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="دوره حسابی جاری" Style="{StaticResource SmallMuted}"/><TextBlock Text="{Binding FinancialPeriodTitle}" FontSize="16" FontWeight="Bold" Margin="0,3,0,0"/><TextBlock Text="{Binding FinancialPeriodDates}" Style="{StaticResource SmallMuted}" Margin="0,3,0,0"/></StackPanel>
     <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="18,0"><ProgressBar Value="{Binding FinancialPeriodProgress}" Maximum="100" Height="7"/><TextBlock Text="{Binding FinancialPeriodStatus}" Style="{StaticResource SmallMuted}" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel>
     <Button Grid.Column="2" Content="شروع دوره جدید" Command="{Binding StartNewPeriodCommand}" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center"/>
    </Grid>
   </Border>
  </Grid>
 </ScrollViewer>
</UserControl>
