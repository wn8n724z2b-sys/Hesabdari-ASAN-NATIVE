<UserControl x:Class="HesabdariAsan.Native.Views.SalesView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Style="{StaticResource PageRoot}" FlowDirection="RightToLeft">
 <UserControl.InputBindings><KeyBinding Key="F4" Command="{Binding CheckoutCommand}"/><KeyBinding Key="P" Modifiers="Control" Command="{Binding PrintLastCommand}"/></UserControl.InputBindings>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="26,24,26,36">
   <StackPanel Margin="0,0,0,18"><TextBlock Text="صندوق فروش" Style="{StaticResource Eyebrow}"/><TextBlock Text="فروش" Style="{StaticResource PageTitle}" Margin="0,2,0,0"/><TextBlock Text="اسکن سریع، ثبت فاکتور و چاپ رسید" Style="{StaticResource SmallMuted}"/></StackPanel>

   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>

    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0" Margin="0,0,7,0" MinHeight="520">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Margin="16" Grid.Row="0">
       <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Grid>
        <TextBox x:Name="ProductSearchBox" Text="{Binding ProductSearch,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" Padding="42,0,115,0" Background="{DynamicResource SoftSurface}" ToolTip="بارکد را اسکن کنید یا نام کالا را بنویسید"><TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding AddExactCommand}"/></TextBox.InputBindings></TextBox>
        <Viewbox Width="20" Height="20" HorizontalAlignment="Left" Margin="12,0,0,0" IsHitTestVisible="False"><Path Data="{StaticResource IconSearch}" Stroke="{DynamicResource Accent}" StrokeThickness="1.8"/></Viewbox>
        <TextBlock Text="آماده اسکن" Foreground="{DynamicResource Success}" FontSize="9.5" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" IsHitTestVisible="False"/>
        <Popup IsOpen="{Binding IsProductResultsOpen}" PlacementTarget="{Binding ElementName=ProductSearchBox}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" Width="650">
         <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="0,0,12,12" Padding="4" Margin="0,-1,0,0" Effect="{DynamicResource CardShadow}">
          <ListBox ItemsSource="{Binding ProductResults}" BorderThickness="0" Background="Transparent" MaxHeight="430" ScrollViewer.VerticalScrollBarVisibility="Auto">
           <ListBox.ItemTemplate><DataTemplate><Button Command="{Binding DataContext.AddProductCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource NavButton}" Padding="10,8" Margin="0,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="105"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Barcode}" Style="{StaticResource SmallMuted}" FlowDirection="LeftToRight" HorizontalAlignment="Right"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding StockText}" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/><TextBlock Grid.Column="2" Text="{Binding SalePriceText}" VerticalAlignment="Center" FontWeight="Bold" FlowDirection="LeftToRight"/></Grid></Button></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
         </Border>
        </Popup>
       </Grid>
       <Button Grid.Column="1" Content="پاک کردن" Command="{Binding ClearCartCommand}" Style="{StaticResource DangerButton}" Margin="9,0,0,0" Padding="14,0"/>
      </Grid>

      <Border Grid.Row="1" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"/>

      <Grid Grid.Row="2">
       <DataGrid ItemsSource="{Binding Cart}" Style="{StaticResource GridStyle}" MinHeight="385">
        <DataGrid.Columns>
         <DataGridTextColumn Header="#" Binding="{Binding RowNumber}" Width="45"/>
         <DataGridTextColumn Header="کالا" Binding="{Binding Name}" Width="2*"/>
         <DataGridTextColumn Header="تعداد" Binding="{Binding QuantityWithUnitText}" Width="78"/>
         <DataGridTextColumn Header="قیمت" Binding="{Binding UnitPriceText}" Width="110"/>
         <DataGridTextColumn Header="جمع" Binding="{Binding LineTotalText}" Width="115"/>
         <DataGridTemplateColumn Header="" Width="132"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button Content="+" Command="{Binding DataContext.IncreaseCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}" Width="34" Height="30" MinHeight="30" Padding="0" Margin="2"/><Button Content="−" Command="{Binding DataContext.DecreaseCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}" Width="34" Height="30" MinHeight="30" Padding="0" Margin="2"/><Button Content="×" Command="{Binding DataContext.RemoveCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource DangerButton}" Width="34" Height="30" MinHeight="30" Padding="0" Margin="2"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        </DataGrid.Columns>
       </DataGrid>
       <Border Background="{DynamicResource Surface}" Margin="1"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Cart.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><Border Width="54" Height="54" CornerRadius="17" Background="{DynamicResource SoftSurface}" HorizontalAlignment="Center"><Viewbox Width="25" Height="25" HorizontalAlignment="Center" VerticalAlignment="Center"><Path Data="{StaticResource IconCart}" Stroke="{DynamicResource Muted}" StrokeThickness="1.5" Fill="Transparent"/></Viewbox></Border><TextBlock Text="فاکتور خالی است" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,3"/><TextBlock Text="یک کالا را اسکن یا جستجو کنید" Style="{StaticResource SmallMuted}" HorizontalAlignment="Center"/></StackPanel></Border>
      </Grid>
     </Grid>
    </Border>

    <Border Grid.Column="1" Style="{StaticResource Card}" Padding="17" Margin="7,0,0,0" VerticalAlignment="Top">
     <StackPanel>
      <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="فاکتور" Style="{StaticResource SmallMuted}"/><TextBlock Text="{Binding NextInvoiceText}" FontSize="14" FontWeight="Bold" Margin="0,3,0,0" FlowDirection="LeftToRight"/></StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Left"><TextBlock Text="وضعیت" Style="{StaticResource SmallMuted}" HorizontalAlignment="Left"/><Border Background="{DynamicResource SuccessSoft}" CornerRadius="999" Padding="8,3" Margin="0,3,0,0"><TextBlock Text="آماده" Foreground="{DynamicResource Success}" FontSize="10" FontWeight="SemiBold"/></Border></StackPanel></Grid>
      <Separator/>
      <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="جمع کالا" Foreground="{DynamicResource Muted}"/><TextBlock Grid.Column="1" Text="{Binding SubtotalText}" FontWeight="Bold" FlowDirection="LeftToRight"/></Grid>
      <Grid Margin="0,9,0,5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><TextBlock Text="تخفیف" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding DiscountText,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" FlowDirection="LeftToRight" Height="36" MinHeight="36"/></Grid>
      <Border Background="{DynamicResource AccentSoft}" CornerRadius="12" Padding="13" Margin="0,8,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="قابل پرداخت" Foreground="{DynamicResource MutedStrong}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding TotalText}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Accent}" FlowDirection="LeftToRight"/></Grid></Border>

      <TextBlock Text="مشتری" Style="{StaticResource SmallMuted}" Margin="0,0,0,5"/>
      <Grid>
       <Button x:Name="CustomerPickerButton" Command="{Binding ToggleCustomerPickerCommand}" Style="{StaticResource SecondaryButton}" Padding="10,6" MinHeight="52" HorizontalContentAlignment="Stretch">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding SelectedCustomerText}" FontWeight="SemiBold" HorizontalAlignment="Right"/><TextBlock Text="{Binding SelectedCustomerMeta}" Style="{StaticResource SmallMuted}" Margin="0,2,0,0" HorizontalAlignment="Right"/></StackPanel><Path Grid.Column="1" Data="M5,8 L11,14 L17,8" Stroke="{DynamicResource Muted}" StrokeThickness="1.7" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
       </Button>
       <Popup IsOpen="{Binding IsCustomerPickerOpen,Mode=TwoWay}" PlacementTarget="{Binding ElementName=CustomerPickerButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" Width="296">
        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="12" Padding="7" Margin="0,5,0,0" Effect="{DynamicResource CardShadow}">
         <StackPanel>
          <Grid Margin="0,0,0,5"><TextBox Text="{Binding CustomerSearch,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" Padding="38,0,10,0" ToolTip="نام یا شماره مشتری..."/><Viewbox Width="18" Height="18" HorizontalAlignment="Left" Margin="11,0" IsHitTestVisible="False"><Path Data="{StaticResource IconSearch}" Stroke="{DynamicResource Muted}" StrokeThickness="1.7"/></Viewbox></Grid>
          <ScrollViewer MaxHeight="330" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding CustomerResults}"><ItemsControl.ItemTemplate><DataTemplate><Button Command="{Binding DataContext.SelectCustomerCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource NavButton}" Padding="9,7"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="95"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Phone}" Style="{StaticResource SmallMuted}" FlowDirection="LeftToRight" HorizontalAlignment="Right"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding DebtText}" VerticalAlignment="Center" FlowDirection="LeftToRight" HorizontalAlignment="Left"/></Grid></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
         </StackPanel>
        </Border>
       </Popup>
      </Grid>
      <TextBlock Text="برای فاکتورهای عادی، مشتری عمومی انتخاب شده است." FontSize="9.5" Foreground="{DynamicResource Muted}" Margin="0,4,0,12"/>

      <TextBlock Text="روش پرداخت را انتخاب کنید" FontSize="10.5" Foreground="{DynamicResource Danger}" Margin="0,0,0,6"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding PaymentRequired}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Button Grid.Column="0" Content="نقدی" Command="{Binding SetPaymentCommand}" CommandParameter="نقدی" Margin="0,0,4,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}"><Style.Triggers><DataTrigger Binding="{Binding IsCash}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoft}"/><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="{DynamicResource Accent}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
       <Button Grid.Column="1" Content="نسیه" Command="{Binding SetPaymentCommand}" CommandParameter="نسیه" Margin="4,0,0,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}"><Style.Triggers><DataTrigger Binding="{Binding IsCredit}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoft}"/><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="{DynamicResource Accent}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
      </Grid>
      <Button Content="ثبت و پرداخت" Command="{Binding CheckoutCommand}" Style="{StaticResource PrimaryButton}" Height="48" FontSize="14"/>
      <Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="F4  پرداخت" FontSize="9.5" Foreground="{DynamicResource Muted}"/><TextBlock Grid.Column="1" Text="Ctrl P  چاپ" FontSize="9.5" Foreground="{DynamicResource Muted}" HorizontalAlignment="Left"/></Grid>
     </StackPanel>
    </Border>
   </Grid>

   <Border Style="{StaticResource Card}" Padding="0" Margin="0,14,0,0">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid Margin="17,14,17,9"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="فاکتورهای اخیر" Style="{StaticResource SectionTitle}"/><TextBlock Text="برای سرعت بیشتر فقط تعداد انتخاب‌شده نمایش داده می‌شود." Style="{StaticResource SmallMuted}" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="نمایش" Style="{StaticResource SmallMuted}" VerticalAlignment="Center"/><ComboBox ItemsSource="{Binding RecentLimits}" SelectedItem="{Binding RecentLimit}" Style="{StaticResource Combo}" Width="78" Height="34" MinHeight="34" Margin="7,0"/><Button Content="آرشیو کامل" Command="{Binding DataContext.NavigateCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Archive" Style="{StaticResource SecondaryButton}" Height="34" MinHeight="34"/></StackPanel></Grid>
     <DataGrid Grid.Row="1" ItemsSource="{Binding RecentInvoices}" Style="{StaticResource GridStyle}" MaxHeight="380"><DataGrid.Columns><DataGridTextColumn Header="فاکتور" Binding="{Binding InvoiceNo}" Width="85"/><DataGridTextColumn Header="زمان" Binding="{Binding DateText}" Width="155"/><DataGridTextColumn Header="مشتری" Binding="{Binding CustomerName}" Width="2*"/><DataGridTextColumn Header="روش" Binding="{Binding PaymentText}" Width="90"/><DataGridTextColumn Header="وضعیت" Binding="{Binding StatusText}" Width="90"/><DataGridTextColumn Header="مبلغ" Binding="{Binding TotalText}" Width="120"/><DataGridTemplateColumn Header="عملیات" Width="90"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="چاپ" Command="{Binding DataContext.PrintInvoiceCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}" Height="30" MinHeight="30" Padding="9,0" FontSize="10.5"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid>
    </Grid>
   </Border>
  </StackPanel>
 </ScrollViewer>
</UserControl>
