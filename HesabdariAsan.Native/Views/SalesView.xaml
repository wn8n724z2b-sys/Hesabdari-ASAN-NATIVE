<UserControl x:Class="HesabdariAsan.Native.Views.SalesView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FlowDirection="RightToLeft">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <TextBlock Text="فروش" Style="{StaticResource PageTitle}"/>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="اقلام فاکتور" FontSize="18" FontWeight="Bold"/>
    <Grid Grid.Row="1" Margin="0,12,0,10">
     <TextBox x:Name="ProductSearchBox" Text="{Binding ProductSearch,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" ToolTip="نام یا بارکد کالا"><TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding AddExactCommand}"/></TextBox.InputBindings></TextBox>
     <Popup IsOpen="{Binding IsProductResultsOpen}" PlacementTarget="{Binding ElementName=ProductSearchBox}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" Width="620">
      <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="12" Padding="6" Margin="0,6,0,0">
       <ListBox ItemsSource="{Binding ProductResults}" BorderThickness="0" Background="Transparent" MaxHeight="430" ScrollViewer.VerticalScrollBarVisibility="Auto">
        <ListBox.ItemTemplate><DataTemplate><Button Command="{Binding DataContext.AddProductCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" Padding="10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="115"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Barcode}" Style="{StaticResource SmallMuted}" FlowDirection="LeftToRight"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding StockText}" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/><TextBlock Grid.Column="2" Text="{Binding SalePriceText}" VerticalAlignment="Center" FontWeight="Bold"/></Grid></Button></DataTemplate></ListBox.ItemTemplate>
       </ListBox>
      </Border>
     </Popup>
    </Grid>
    <DataGrid Grid.Row="2" ItemsSource="{Binding Cart}" Style="{StaticResource GridStyle}" MaxHeight="470"><DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding RowNumber}" Width="45"/><DataGridTextColumn Header="کالا" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="تعداد" Binding="{Binding QuantityText}" Width="75"/><DataGridTextColumn Header="فی" Binding="{Binding UnitPriceText}" Width="105"/><DataGridTextColumn Header="جمع" Binding="{Binding LineTotalText}" Width="110"/><DataGridTemplateColumn Header="" Width="130"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Content="+" Command="{Binding DataContext.IncreaseCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}" Padding="8,4" Margin="1"/><Button Content="−" Command="{Binding DataContext.DecreaseCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}" Padding="8,4" Margin="1"/><Button Content="×" Command="{Binding DataContext.RemoveCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource DangerButton}" Padding="8,4" Margin="1"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid>
    <Grid Grid.Row="3" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding SubtotalLabel}" FontSize="17" FontWeight="Bold"/><TextBlock Grid.Column="1" Text="تخفیف" VerticalAlignment="Center" Margin="10,0"/><TextBox Grid.Column="2" Text="{Binding DiscountText,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" Width="120" FlowDirection="LeftToRight"/></Grid>
   </Grid></Border>
   <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0"><StackPanel>
    <TextBlock Text="تسویه" FontSize="18" FontWeight="Bold" Margin="0,0,0,14"/>
    <TextBlock Text="مشتری" Style="{StaticResource SmallMuted}"/>
    <Grid Margin="0,5,0,10"><TextBox x:Name="CustomerSearchBox" Text="{Binding CustomerSearch,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" ToolTip="نام یا شماره تماس"/>
     <Popup IsOpen="{Binding IsCustomerResultsOpen}" PlacementTarget="{Binding ElementName=CustomerSearchBox}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" Width="420">
      <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="12" Padding="6" Margin="0,6,0,0"><ListBox ItemsSource="{Binding CustomerResults}" MaxHeight="330" BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto"><ListBox.ItemTemplate><DataTemplate><Button Command="{Binding DataContext.SelectCustomerCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" Padding="9"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Phone}" Style="{StaticResource SmallMuted}" FlowDirection="LeftToRight"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding DebtText}" VerticalAlignment="Center"/></Grid></Button></DataTemplate></ListBox.ItemTemplate></ListBox></Border>
     </Popup>
    </Grid>
    <Border Background="{DynamicResource SoftSurface}" CornerRadius="10" Padding="12" Margin="0,0,0,14"><StackPanel><TextBlock Text="مشتری انتخاب‌شده" Style="{StaticResource SmallMuted}"/><TextBlock Text="{Binding SelectedCustomerText}" FontSize="17" FontWeight="Bold" Margin="0,5,0,0"/></StackPanel></Border>
    <TextBlock Text="روش پرداخت" Style="{StaticResource SmallMuted}"/><ComboBox ItemsSource="{Binding PaymentOptions}" SelectedItem="{Binding PaymentText}" Style="{StaticResource Combo}" Margin="0,5,0,18"/>
    <Border Background="{DynamicResource AccentSoft}" CornerRadius="14" Padding="16" Margin="0,0,0,14"><StackPanel><TextBlock Text="مبلغ قابل پرداخت" Foreground="{DynamicResource Muted}"/><TextBlock Text="{Binding TotalText}" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource Accent}" Margin="0,6,0,0"/></StackPanel></Border>
    <Button Content="ثبت فاکتور" Command="{Binding CheckoutCommand}" Style="{StaticResource PrimaryButton}" Padding="18,13"/>
    <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding LastInvoiceText}" Style="{StaticResource SmallMuted}" VerticalAlignment="Center"/><Button Grid.Column="1" Content="چاپ آخرین فاکتور" Command="{Binding PrintLastCommand}" Style="{StaticResource SecondaryButton}" Padding="12,7"/></Grid>
   </StackPanel></Border>
  </Grid>
 </Grid>
</UserControl>
