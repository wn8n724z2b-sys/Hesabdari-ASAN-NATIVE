<UserControl x:Class="HesabdariAsan.Native.Views.DataSupportView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource PageRoot}" FlowDirection="RightToLeft">
 <Grid Margin="26,24,26,36"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,18"><TextBlock Text="امنیت اطلاعات" Style="{StaticResource Eyebrow}"/><TextBlock Text="داده‌ها و پشتیبانی" Style="{StaticResource PageTitle}"/><TextBlock Text="Backup، بازیابی، انتقال نسخه قدیمی و سلامت دیتابیس" Style="{StaticResource SmallMuted}"/></StackPanel>
  <Grid Grid.Row="1">
   <Border HorizontalAlignment="Center" VerticalAlignment="Top" Width="520" Padding="28">
    <Border.Style><Style TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsLocked}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
    <StackPanel><Border Width="58" Height="58" CornerRadius="18" Background="{DynamicResource AccentSoft}" HorizontalAlignment="Center"><Viewbox Width="27" Height="27"><Path Data="M7,11 L7,8 C7,4 17,4 17,8 L17,11 M5,11 L19,11 L19,21 L5,21 Z M12,15 L12,18" Stroke="{DynamicResource Accent}" StrokeThickness="1.8" Fill="Transparent"/></Viewbox></Border><TextBlock Text="بخش محافظت‌شده" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,14,0,4"/><TextBlock Text="{Binding LockHint}" Style="{StaticResource SmallMuted}" HorizontalAlignment="Center"/><PasswordBox x:Name="AdminPasswordBox" Height="42" Margin="0,18,0,10" Padding="11" KeyDown="AdminPassword_KeyDown"/><Button Content="باز کردن بخش" Click="Unlock_Click" Style="{StaticResource PrimaryButton}" Height="43"/><Button Content="تنظیم / تغییر رمز مدیر" Command="{Binding ChangePasswordCommand}" Style="{StaticResource LinkButton}" Margin="0,8,0,0"/></StackPanel>
   </Border>

   <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsUnlocked}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
    <Border Style="{StaticResource Card}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid Margin="20,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="مرکز داده‌ها" Style="{StaticResource SectionTitle}"/><TextBlock Text="تمام عملیات Backup با بررسی سلامت SQLite انجام می‌شود." Style="{StaticResource SmallMuted}" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Border Style="{StaticResource Pill}" Background="{DynamicResource SuccessSoft}" BorderBrush="Transparent"><TextBlock Text="SQLite · WAL" Foreground="{DynamicResource Success}" FontWeight="Bold"/></Border><Button Content="قفل" Command="{Binding LockCommand}" Style="{StaticResource SecondaryButton}" Height="32" MinHeight="32" Margin="8,0,0,0"/><Button Content="تغییر رمز" Command="{Binding ChangePasswordCommand}" Style="{StaticResource SecondaryButton}" Height="32" MinHeight="32" Margin="6,0,0,0"/></StackPanel></Grid>
     <Border Grid.Row="1" Background="{DynamicResource SoftSurface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,1" Padding="18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="پشتیبان خودکار" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding BackupOptions}" SelectedItem="{Binding AutoBackupPerDay}" Style="{StaticResource Combo}"/></StackPanel><StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding LastBackup}" FontWeight="SemiBold"/><TextBlock Text="فایل‌ها در پوشه اختصاصی حسابداری آسان نگهداری می‌شوند." Style="{StaticResource SmallMuted}" Margin="0,3,0,0"/></StackPanel></Grid></Border>
     <UniformGrid Grid.Row="2" Columns="3" Margin="15"><Button Content="ذخیره دستی Backup" Command="{Binding BackupCommand}" Style="{StaticResource PrimaryButton}" Margin="5"/><Button Content="بازیابی فایل Backup" Command="{Binding RestoreCommand}" Style="{StaticResource SecondaryButton}" Margin="5"/><Button Content="بازیابی آخرین Backup" Command="{Binding RestoreLatestCommand}" Style="{StaticResource SecondaryButton}" Margin="5"/><Button Content="پوشه Backup" Command="{Binding OpenFolderCommand}" Style="{StaticResource SecondaryButton}" Margin="5"/><Button Content="بررسی سلامت دیتابیس" Command="{Binding CheckDatabaseCommand}" Style="{StaticResource SecondaryButton}" Margin="5"/><Button Content="انتقال اطلاعات از v3.4" Command="{Binding MigrateV34Command}" Style="{StaticResource SecondaryButton}" Margin="5"/><Button Content="ثبت رویدادها" Click="OpenAudit_Click" Style="{StaticResource SecondaryButton}" Margin="5"/><Button Content="پاک‌کردن همه اطلاعات" Command="{Binding ResetCommand}" Style="{StaticResource DangerGhostButton}" Margin="5"/></UniformGrid>
     <StackPanel Grid.Row="3" Margin="20,0,20,20">
      <Border Background="{DynamicResource SoftSurface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,10">
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="وضعیت موتور داده" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding DatabaseSummary}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
        <Button Grid.Column="1" Content="بهینه‌سازی دیتابیس" Command="{Binding OptimizeDatabaseCommand}" Style="{StaticResource SecondaryButton}" Margin="14,0,0,0" Padding="16,8" VerticalAlignment="Center"/>
       </Grid>
      </Border>
      <Border Background="{DynamicResource AccentSoft}" CornerRadius="10" Padding="12" Margin="0,0,0,10"><TextBlock Text="قبل از Restore و انتقال v3.4 یک Backup ایمنی خودکار ساخته می‌شود؛ Uninstall نیز دیتابیس کاربر را پاک نمی‌کند." TextWrapping="Wrap" Foreground="{DynamicResource Accent}"/></Border>
      <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Success}" FontWeight="SemiBold"/>
     </StackPanel>
    </Grid></Border>
   </StackPanel></ScrollViewer>
  </Grid>
 </Grid>
</UserControl>
