<UserControl x:Class="HesabdariAsan.Native.Views.DataSupportView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource PageRoot}" FlowDirection="RightToLeft">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,16"><TextBlock Text="امنیت اطلاعات" Style="{StaticResource Eyebrow}"/><TextBlock Text="داده‌ها و پشتیبانی" Style="{StaticResource PageTitle}" Margin="0,2,0,0"/><TextBlock Text="Backup، بازیابی، انتقال نسخه قدیمی و سلامت دیتابیس" Style="{StaticResource SmallMuted}"/></StackPanel>
  <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid Margin="20,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="مرکز داده‌ها" Style="{StaticResource SectionTitle}"/><TextBlock Text="تمام عملیات Backup با بررسی سلامت SQLite انجام می‌شود." Style="{StaticResource SmallMuted}" Margin="0,3,0,0"/></StackPanel><Border Grid.Column="1" Style="{StaticResource Pill}" Background="{DynamicResource SuccessSoft}" BorderBrush="Transparent"><TextBlock Text="SQLite · WAL" Foreground="{DynamicResource Success}" FontWeight="Bold"/></Border></Grid>
   <Border Grid.Row="1" Background="{DynamicResource SoftSurface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,1" Padding="18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="پشتیبان خودکار" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding BackupOptions}" SelectedItem="{Binding AutoBackupPerDay}" Style="{StaticResource Combo}"/></StackPanel><StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding LastBackup}" FontWeight="SemiBold"/><TextBlock Text="فایل‌ها در پوشه اختصاصی حسابداری آسان نگهداری می‌شوند." Style="{StaticResource SmallMuted}" Margin="0,3,0,0"/></StackPanel></Grid></Border>
   <UniformGrid Grid.Row="2" Columns="3" Margin="15"><Button Content="ذخیره دستی Backup" Command="{Binding BackupCommand}" Style="{StaticResource PrimaryButton}" Margin="5"/><Button Content="بازیابی فایل Backup" Command="{Binding RestoreCommand}" Style="{StaticResource SecondaryButton}" Margin="5"/><Button Content="بازیابی آخرین Backup" Command="{Binding RestoreLatestCommand}" Style="{StaticResource SecondaryButton}" Margin="5"/><Button Content="پوشه Backup" Command="{Binding OpenFolderCommand}" Style="{StaticResource SecondaryButton}" Margin="5"/><Button Content="بررسی سلامت دیتابیس" Command="{Binding CheckDatabaseCommand}" Style="{StaticResource SecondaryButton}" Margin="5"/><Button Content="انتقال اطلاعات از v3.4" Command="{Binding MigrateV34Command}" Style="{StaticResource SecondaryButton}" Margin="5"/><Button Content="فعالیت‌های اخیر فاکتورها" Click="OpenAudit_Click" Style="{StaticResource SecondaryButton}" Margin="5"/></UniformGrid>
   <StackPanel Grid.Row="3" Margin="20,0,20,20"><Border Background="{DynamicResource AccentSoft}" CornerRadius="10" Padding="12" Margin="0,0,0,10"><TextBlock Text="قبل از Restore و انتقال v3.4 یک Backup ایمنی خودکار ساخته می‌شود؛ Uninstall نیز دیتابیس کاربر را پاک نمی‌کند." TextWrapping="Wrap" Foreground="{DynamicResource Accent}"/></Border><TextBlock Text="{Binding Status}" Foreground="{DynamicResource Success}" FontWeight="SemiBold"/></StackPanel>
  </Grid></Border>
 </Grid>
</UserControl>
